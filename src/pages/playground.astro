---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NebulaGradient from '@/components/astro/NebulaGradient.astro';
import CodePlayground from '@/components/react/CodePlayground';
import ModelDemo from '@/components/react/ModelDemo';
import DatasetViewer from '@/components/react/DatasetViewer';
import NotebookViewer from '@/components/react/NotebookViewer';
import { getSiteSettings, isPageVisible } from '@/lib/supabase';
import PageNotAvailable from '@/components/astro/PageNotAvailable.astro';

const settings = await getSiteSettings();
const pageVisible = isPageVisible(settings, '/playground');

// Sample dataset for demo
const sampleData = [
  { id: 1, name: 'BERT', type: 'NLP', params: '110M', year: 2018, open_source: true },
  { id: 2, name: 'GPT-2', type: 'NLP', params: '1.5B', year: 2019, open_source: true },
  { id: 3, name: 'T5', type: 'NLP', params: '11B', year: 2019, open_source: true },
  { id: 4, name: 'GPT-3', type: 'NLP', params: '175B', year: 2020, open_source: false },
  { id: 5, name: 'DALL-E', type: 'Vision', params: '12B', year: 2021, open_source: false },
  { id: 6, name: 'LLaMA', type: 'NLP', params: '65B', year: 2023, open_source: true },
  { id: 7, name: 'Mistral', type: 'NLP', params: '7B', year: 2023, open_source: true },
  { id: 8, name: 'Claude', type: 'NLP', params: 'Unknown', year: 2024, open_source: false },
  { id: 9, name: 'Gemma', type: 'NLP', params: '7B', year: 2024, open_source: true },
  { id: 10, name: 'Phi-3', type: 'NLP', params: '3.8B', year: 2024, open_source: true },
];

// Sample notebook
const sampleNotebook = {
  cells: [
    {
      cell_type: 'markdown' as const,
      source: ['# Hello from Jupyter!\n', '\n', 'This is a sample notebook demonstrating the **NotebookViewer** component.'],
      outputs: [],
    },
    {
      cell_type: 'code' as const,
      source: ['import numpy as np\n', 'import pandas as pd\n', '\n', '# Create sample data\n', 'data = np.random.randn(100, 3)\n', 'df = pd.DataFrame(data, columns=["A", "B", "C"])\n', 'df.describe()'],
      execution_count: 1,
      outputs: [
        {
          output_type: 'execute_result',
          data: {
            'text/plain': [
              '              A          B          C\n',
              'count  100.000000  100.000000  100.000000\n',
              'mean    -0.032892    0.089012    0.042103\n',
              'std      1.021390    0.987654    1.013210\n',
            ],
          },
        },
      ],
    },
    {
      cell_type: 'code' as const,
      source: ['# Plot results\n', 'print("Visualization would go here")\n', 'print(f"DataFrame shape: {df.shape}")'],
      execution_count: 2,
      outputs: [
        {
          output_type: 'stream',
          text: ['Visualization would go here\n', 'DataFrame shape: (100, 3)\n'],
        },
      ],
    },
  ],
  metadata: {
    kernelspec: { display_name: 'Python 3', language: 'python' },
    language_info: { name: 'python', version: '3.11.0' },
  },
};
---

{pageVisible ? (
<BaseLayout
  title="Interactive Playground | Mahir Faysal Tushar"
  description="Interactive research tools: Python playground, notebook viewer, model demos, and dataset explorer."
>
  <section class="max-w-5xl mx-auto px-4 py-12 sm:px-6 lg:px-8 relative">
    <NebulaGradient variant="subtle" />
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold font-serif text-secondary-50 mb-4">
        Interactive Playground
      </h1>
      <p class="text-lg text-secondary-300 max-w-2xl mx-auto">
        Experiment with Python code, explore datasets, view notebooks, and try ML model demos right in your browser.
      </p>
    </div>

    <!-- Python Code Playground -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold font-serif text-secondary-100 mb-4 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-yellow-500"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
        Python Code Playground
      </h2>
      <p class="text-sm text-secondary-400 mb-4">
        Run Python code directly in the browser using Pyodide (WebAssembly). Supports numpy, pandas, and more.
      </p>
      <CodePlayground
        client:visible
        initialCode={`# Python runs in your browser via Pyodide!\nimport sys\nprint(f"Python {sys.version}")\n\n# Try some math\nresult = sum(range(1, 101))\nprint(f"Sum of 1 to 100 = {result}")\n\n# String processing\ntext = "Hello, AI/ML World!"\nprint(f"Reversed: {text[::-1]}")\nprint(f"Words: {text.split()}")`}
      />
    </div>

    <!-- Notebook Viewer -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold font-serif text-secondary-100 mb-4 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>
        Notebook Viewer
      </h2>
      <p class="text-sm text-secondary-400 mb-4">
        View Jupyter notebooks with code cells, outputs, and markdown rendered inline.
      </p>
      <NotebookViewer
        client:visible
        notebook={sampleNotebook}
        title="sample_analysis.ipynb"
      />
    </div>

    <!-- Dataset Viewer -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold font-serif text-secondary-100 mb-4 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-blue-500"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"></path></svg>
        Dataset Viewer
      </h2>
      <p class="text-sm text-secondary-400 mb-4">
        Explore datasets with search, sort, and pagination. Columns are automatically typed.
      </p>
      <DatasetViewer
        client:visible
        data={sampleData}
        title="AI/ML Models Registry"
      />
    </div>

    <!-- Model Demo -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold font-serif text-secondary-100 mb-4 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-purple-500"><path d="M12 2a4 4 0 0 0-4 4v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2h-2V6a4 4 0 0 0-4-4z"></path></svg>
        Model Demo
      </h2>
      <p class="text-sm text-secondary-400 mb-4">
        Embed Hugging Face Spaces, Gradio apps, or Streamlit demos directly in your posts.
      </p>
      <ModelDemo
        client:visible
        src="https://huggingface.co/spaces/stabilityai/stable-diffusion"
        title="Stable Diffusion Demo"
        description="Generate images from text prompts using Stable Diffusion."
        height="500px"
      />
    </div>
  </section>
</BaseLayout>
) : (
<PageNotAvailable pageTitle="Playground" />
)}
