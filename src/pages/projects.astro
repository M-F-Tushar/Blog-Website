---
import BaseLayout from '@/layouts/BaseLayout.astro';
import NebulaGradient from '@/components/astro/NebulaGradient.astro';
import CosmicDivider from '@/components/astro/CosmicDivider.astro';
import { getProjects, getSiteSettings, isPageVisible } from '@/lib/supabase';

const settings = await getSiteSettings();
const pageVisible = isPageVisible(settings, '/projects');
const allProjects = await getProjects();

const statusColors: Record<string, string> = {
  active: 'bg-primary-500/10 text-primary-300 border border-primary-500/20',
  experimental: 'bg-accent-500/10 text-accent-300 border border-accent-500/20',
  archived: 'bg-white/5 text-secondary-400 border border-white/10',
  completed: 'bg-green-500/10 text-green-300 border border-green-500/20',
};

const featuredProjects = allProjects.filter((p) => p.isFeatured);
const otherProjects = allProjects.filter((p) => !p.isFeatured);
---

{pageVisible ? (
<BaseLayout
  title="Projects | Mahir Faysal Tushar"
  description="Open-source projects and research tools in AI/ML, MLOps, web development, and data science."
>
  <section class="max-w-6xl mx-auto px-4 py-12 sm:px-6 lg:px-8 relative">
    <NebulaGradient variant="subtle" />
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold font-serif text-secondary-50 mb-4">
        Projects
      </h1>
      <p class="text-lg text-secondary-300 max-w-2xl mx-auto">
        Open-source tools, research projects, and experiments in AI/ML, MLOps, and web development.
      </p>
      <a
        href="https://github.com/M-F-Tushar"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 mt-4 text-sm font-medium text-primary-400 hover:text-primary-300 transition-colors"
      >
        <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
        View all on GitHub
      </a>
    </div>

    <!-- Featured projects -->
    {featuredProjects.length > 0 && (
      <div class="mb-12">
        <h2 class="text-2xl font-bold font-serif text-secondary-100 mb-6">
          Featured Projects
        </h2>
        <div class="grid md:grid-cols-2 gap-6">
          {featuredProjects.map((project) => (
            <article class="glass-cosmic rounded-xl overflow-hidden border border-white/[0.06] hover:border-primary-500/20 hover:shadow-cosmic-card transition-all group">
              {project.imageUrl && (
                <div class="h-48 overflow-hidden">
                  <img
                    src={project.imageUrl}
                    alt={project.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                  />
                </div>
              )}
              <div class="p-6">
                <div class="flex items-center gap-2 mb-3">
                  <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${statusColors[project.status]}`}>
                    {project.status}
                  </span>
                  <span class="text-xs font-semibold bg-gold-500/10 text-gold-400 border border-gold-500/20 px-2 py-0.5 rounded-full">
                    Featured
                  </span>
                </div>

                <h3 class="text-xl font-bold text-secondary-50 mb-2 group-hover:text-primary-400 transition-colors">
                  {project.title}
                </h3>

                <p class="text-secondary-300 text-sm mb-4 line-clamp-3">
                  {project.description}
                </p>

                <div class="flex flex-wrap gap-1.5 mb-4">
                  {project.techStack.map((tag) => (
                    <span class="text-xs bg-white/5 text-secondary-300 border border-white/10 px-2 py-0.5 rounded-full">
                      {tag}
                    </span>
                  ))}
                </div>

                <div class="flex gap-3">
                  {project.githubUrl && (
                    <a
                      href={project.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium bg-white/5 text-secondary-200 border border-white/10 rounded-lg hover:border-primary-500/30 transition-colors"
                    >
                      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                      Source
                    </a>
                  )}
                  {project.liveUrl && (
                    <a
                      href={project.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 px-4 py-2 text-sm font-medium bg-primary-600 text-white rounded-lg hover:bg-primary-500 transition-colors"
                    >
                      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                      Demo
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    )}

    <CosmicDivider variant="line" />

    <!-- All projects -->
    {otherProjects.length > 0 && (
      <div>
        <h2 class="text-2xl font-bold font-serif text-secondary-100 mb-6">
          Other Projects
        </h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {otherProjects.map((project) => (
            <article class="glass-cosmic rounded-xl p-5 border border-white/[0.06] hover:border-primary-500/20 hover:shadow-cosmic-card transition-all group">
              <div class="flex items-center gap-2 mb-3">
                <span class={`text-xs font-semibold px-2 py-0.5 rounded-full ${statusColors[project.status]}`}>
                  {project.status}
                </span>
              </div>

              <h3 class="text-lg font-bold text-secondary-50 mb-2 group-hover:text-primary-400 transition-colors">
                {project.githubUrl ? (
                  <a href={project.githubUrl} target="_blank" rel="noopener noreferrer">
                    {project.title}
                  </a>
                ) : (
                  project.title
                )}
              </h3>

              <p class="text-secondary-300 text-sm mb-4 line-clamp-2">
                {project.description}
              </p>

              <div class="flex flex-wrap gap-1.5">
                {project.techStack.slice(0, 4).map((tag) => (
                  <span class="text-xs bg-white/5 text-secondary-300 border border-white/10 px-2 py-0.5 rounded-full">
                    {tag}
                  </span>
                ))}
              </div>
            </article>
          ))}
        </div>
      </div>
    )}
  </section>
</BaseLayout>
) : (
<html><head><meta http-equiv="refresh" content="0;url=/" /></head><body></body></html>
)}
