---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnimatedSection from '../../components/astro/AnimatedSection.astro';
import BlogCard from '../../components/astro/BlogCard.astro';
import CosmicDivider from '../../components/astro/CosmicDivider.astro';
import Pagination from '../../components/astro/Pagination.astro';
import { getPublishedPosts, slugify, getSiteSettings, isPageVisible } from '@/lib/supabase';

const POSTS_PER_PAGE = 9;

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const postsPerPage = 9;
  const totalPages = Math.max(1, Math.ceil(allPosts.length / postsPerPage));

  return Array.from({ length: totalPages }, (_, i) => ({
    params: { page: i === 0 ? undefined : String(i + 1) },
    props: { currentPage: i + 1 },
  }));
}

const { currentPage } = Astro.props;
const settings = await getSiteSettings();
const pageVisible = isPageVisible(settings, '/blog');

const allPosts = await getPublishedPosts();
const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE);
const posts = allPosts.slice((currentPage - 1) * POSTS_PER_PAGE, currentPage * POSTS_PER_PAGE);
const featuredPost = currentPage === 1 ? posts[0] : null;
const gridPosts = currentPage === 1 ? posts.slice(1) : posts;

const categories = [...new Set(allPosts.map((p) => p.category))].sort();
const categoryCounts = categories.map((category) => ({
  category,
  count: allPosts.filter((post) => post.category === category).length,
}));
const tagCounts: Record<string, number> = {};
allPosts.forEach((post) => {
  post.tags?.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});
const topTags = Object.entries(tagCounts)
  .sort((a, b) => b[1] - a[1])
  .slice(0, 8);
---

{pageVisible ? (
  <BaseLayout
    title={currentPage === 1 ? 'Writing' : `Writing - Page ${currentPage}`}
    description="Research essays, machine learning notes, and technical writing on AI systems."
  >
    <div class="pb-16">
      <section class="page-hero">
        <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="max-w-3xl space-y-6">
            <span class="section-eyebrow">Writing</span>
            <h1 class="section-heading">
              Essays, field notes, and practical thinking on modern AI systems.
            </h1>
            <p class="section-copy max-w-2xl">
              This archive is organized like a publication, not a feed. Start with a lead essay,
              browse by topic, or jump into the latest notes.
            </p>
          </div>

          <div class="mt-10 grid gap-4 md:grid-cols-3">
            <div class="editorial-metric">
              <span class="text-xs uppercase tracking-[0.2em] text-secondary-500">Articles</span>
              <strong class="mt-2 block text-3xl font-semibold text-secondary-50">{allPosts.length}</strong>
            </div>
            <div class="editorial-metric">
              <span class="text-xs uppercase tracking-[0.2em] text-secondary-500">Topics</span>
              <strong class="mt-2 block text-3xl font-semibold text-secondary-50">{categories.length}</strong>
            </div>
            <div class="editorial-metric">
              <span class="text-xs uppercase tracking-[0.2em] text-secondary-500">Most active lane</span>
              <strong class="mt-2 block text-xl font-semibold text-secondary-50">
                {categoryCounts[0]?.category || 'Research notes'}
              </strong>
            </div>
          </div>
        </div>
      </section>

      <section class="section-shell section-break-sm">
        <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="surface-panel-strong p-5 md:p-6">
            <div class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between">
              <div>
                <p class="editorial-kicker">Browse by topic</p>
                <h2 class="mt-2 font-serif text-2xl text-secondary-50">Editorial lanes</h2>
              </div>
              <div class="flex flex-wrap gap-2">
                {categoryCounts.map(({ category, count }) => (
                  <a
                    href={`/blog/categories/${slugify(category)}`}
                    class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm text-secondary-300 transition-colors hover:border-primary-500/30 hover:text-primary-100"
                  >
                    <span>{category}</span>
                    <span class="text-secondary-500">{count}</span>
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </section>

      {featuredPost && (
        <div class="section-shell">
          <CosmicDivider variant="star" />
        </div>
      )}

      {featuredPost && (
        <section class="section-shell section-break-sm">
          <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
            <div class="mb-6 flex items-end justify-between gap-4">
              <div>
                <p class="editorial-kicker">Lead story</p>
                <h2 class="mt-2 font-serif text-3xl text-secondary-50">Start here</h2>
              </div>
              <a href="/search" class="link-subtle hidden md:inline-flex">Search the archive</a>
            </div>
            <BlogCard post={featuredPost} featured={true} />
          </div>
        </section>
      )}

      <div class="section-shell">
        <CosmicDivider variant="line" />
      </div>

      <section class="section-shell section-break-sm">
        <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
          <div class="grid gap-12 xl:grid-cols-[minmax(0,1fr)_19rem]">
            <div class="space-y-8">
              <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
                <div>
                  <p class="editorial-kicker">Latest writing</p>
                  <h2 class="mt-2 font-serif text-3xl text-secondary-50">
                    {currentPage === 1 ? 'Recent essays' : `Page ${currentPage}`}
                  </h2>
                </div>
                <p class="max-w-xl text-sm leading-7 text-secondary-400">
                  Each piece is written as a durable note: enough context to be useful now,
                  enough structure to remain useful later.
                </p>
              </div>

              {gridPosts.length > 0 ? (
                <>
                  <div class="grid gap-6 md:grid-cols-2">
                    {gridPosts.map((post, index) => (
                      <AnimatedSection preset="stagger-cards" index={index}>
                        <div class="card-lift">
                          <BlogCard post={post} compact={true} />
                        </div>
                      </AnimatedSection>
                    ))}
                  </div>
                  <Pagination currentPage={currentPage} totalPages={totalPages} basePath="/blog" />
                </>
              ) : (
                <div class="surface-panel px-8 py-16 text-center">
                  <h2 class="font-serif text-3xl text-secondary-50">No essays yet</h2>
                  <p class="mt-4 text-secondary-400">The archive is being prepared. Check back soon.</p>
                </div>
              )}
            </div>

            <aside class="space-y-6">
              <div class="surface-panel p-6">
                <p class="editorial-kicker">Discovery</p>
                <h3 class="mt-2 font-serif text-2xl text-secondary-50">Popular topics</h3>
                <div class="mt-5 flex flex-wrap gap-2">
                  {topTags.map(([tag, count]) => (
                    <a
                      href={`/blog/tags/${tag}`}
                      class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-secondary-300 transition-colors hover:border-primary-500/30 hover:text-primary-100"
                    >
                      <span>#{tag}</span>
                      <span class="text-secondary-500">{count}</span>
                    </a>
                  ))}
                </div>
              </div>

              <div class="surface-panel p-6">
                <p class="editorial-kicker">Reading paths</p>
                <h3 class="mt-2 font-serif text-2xl text-secondary-50">Suggested routes</h3>
                <div class="mt-5 space-y-3">
                  <a href="/projects" class="topic-lane card-lift">
                    <span class="font-semibold text-secondary-50">See what I’m building</span>
                    <span class="text-sm leading-6 text-secondary-400">Projects that complement the ideas in the writing.</span>
                  </a>
                  <a href="/publications" class="topic-lane card-lift">
                    <span class="font-semibold text-secondary-50">Research archive</span>
                    <span class="text-sm leading-6 text-secondary-400">Papers, publications, and references behind the work.</span>
                  </a>
                  <a href="/recommendations" class="topic-lane card-lift">
                    <span class="font-semibold text-secondary-50">Recommended resources</span>
                    <span class="text-sm leading-6 text-secondary-400">Books, tools, and materials that shaped the thinking.</span>
                  </a>
                </div>
              </div>
            </aside>
          </div>
        </div>
      </section>
    </div>
  </BaseLayout>
) : (
  <html><head><meta http-equiv="refresh" content="0;url=/" /></head><body></body></html>
)}
