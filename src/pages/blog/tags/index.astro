---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getPublishedPosts } from '@/lib/supabase';

const posts = await getPublishedPosts();

// Build tag counts
const tagCounts: Record<string, number> = {};
posts.forEach((p) => {
  p.tags?.forEach((tag) => {
    tagCounts[tag] = (tagCounts[tag] || 0) + 1;
  });
});

const sortedTags = Object.entries(tagCounts).sort((a, b) => b[1] - a[1]);
const maxCount = sortedTags.length > 0 ? sortedTags[0][1] : 1;
---

<BaseLayout title="All Tags" description="Browse all tags used across articles.">
  <div class="pb-12">
    <section class="relative py-12 md:py-16 bg-abyss/80 -mt-20 pt-32 px-4 text-center">
      <div class="max-w-3xl mx-auto relative z-10">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface border border-white/10 mb-6">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-500"><path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"></path><path d="M7 7h.01"></path></svg>
          <span class="text-sm font-medium text-secondary-300">Tags</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold font-serif text-secondary-50 mb-6">
          All <span class="text-gradient">Tags</span>
        </h1>
        <p class="text-lg text-secondary-300 max-w-2xl mx-auto">
          {sortedTags.length} tags across {posts.length} articles
        </p>
      </div>
    </section>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-4xl mt-12">
      {sortedTags.length > 0 ? (
        <div class="flex flex-wrap gap-3 justify-center">
          {sortedTags.map(([tag, count]) => {
            const sizeScale = Math.max(0.75, Math.min(1.5, count / maxCount + 0.5));
            return (
              <a
                href={`/blog/tags/${tag}`}
                class="group inline-flex items-center gap-2 px-4 py-2 bg-surface rounded-full border border-white/10 hover:border-primary-500 transition-all"
                style={`font-size: ${sizeScale}rem;`}
              >
                <span class="text-secondary-300 group-hover:text-primary-400 transition-colors">
                  #{tag}
                </span>
                <span class="text-xs bg-white/5 text-secondary-500 px-2 py-0.5 rounded-full border border-white/10">
                  {count}
                </span>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-20">
          <h2 class="text-2xl font-bold text-secondary-50 mb-4">No tags yet</h2>
          <p class="text-secondary-400">Tags will appear as articles are published.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
