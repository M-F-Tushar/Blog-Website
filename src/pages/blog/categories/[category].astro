---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/astro/BlogCard.astro';
import { getPublishedPosts, slugify } from '@/lib/supabase';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  // Collect all unique categories
  const categorySet = new Set<string>();
  posts.forEach((p) => categorySet.add(p.category));

  return Array.from(categorySet).map((cat) => ({
    params: { category: slugify(cat) },
    props: {
      category: cat,
      posts: posts.filter((p) => p.category === cat),
    },
  }));
}

const { category, posts } = Astro.props;
---

<BaseLayout title={`${category}`} description={`Articles in the "${category}" category.`}>
  <div class="pb-12">
    <section class="relative py-12 md:py-16 bg-secondary-50 dark:bg-secondary-900/50 -mt-20 pt-32 px-4 text-center">
      <div class="max-w-3xl mx-auto relative z-10">
        <a
          href="/blog"
          class="inline-flex items-center gap-1 text-sm text-secondary-500 dark:text-secondary-400 hover:text-primary-600 dark:hover:text-primary-400 mb-4 transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
          All Articles
        </a>
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-accent-100 dark:bg-accent-900/30 text-accent-700 dark:text-accent-300 font-medium mb-6">
          {category}
        </div>
        <h1 class="text-4xl md:text-5xl font-bold font-serif text-secondary-900 dark:text-white mb-6">
          {category} <span class="text-gradient">Articles</span>
        </h1>
        <p class="text-lg text-secondary-600 dark:text-secondary-300">
          {posts.length} {posts.length === 1 ? 'article' : 'articles'} in this category
        </p>
      </div>
    </section>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl mt-12">
      {posts.length > 0 ? (
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <h2 class="text-2xl font-bold text-secondary-900 dark:text-white mb-4">No articles found</h2>
          <p class="text-secondary-600 dark:text-secondary-400">No articles in this category yet.</p>
        </div>
      )}
    </div>
  </div>
</BaseLayout>
