---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/react/ContactForm';
import NebulaGradient from '@/components/astro/NebulaGradient.astro';
import { getSiteSettings, getPageSection } from '@/lib/supabase';

const settings = await getSiteSettings();

const formspreeEndpoint = import.meta.env.PUBLIC_FORMSPREE_ENDPOINT || import.meta.env.VITE_FORMSPREE_ENDPOINT;

const contactInfo = await getPageSection('contact', 'info');
const cmsFaqs = contactInfo?.content?.faq || [];

const faqs = cmsFaqs.length > 0
  ? cmsFaqs.map((f: any) => ({ question: f.q, answer: f.a }))
  : [
      { question: "What's the best way to reach you?", answer: 'Email is the best way. I typically respond within 24-48 hours during business days.' },
      { question: 'Do you accept collaborations?', answer: "I'm always open to research collaborations, especially in AI/ML. Send me details about your project." },
      { question: 'Can you help with my ML project?', answer: "I'd love to hear about it! Email me with details about what you're building, and I'll see how I can help." },
      { question: 'Do you accept guest posts?', answer: "I occasionally accept high-quality guest posts related to AI/ML, research, or CS topics. Reach out with your proposal." },
      { question: 'Are you available for speaking?', answer: "Yes! I enjoy giving talks about AI/ML topics. Feel free to reach out with details about the event." },
    ];
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${settings.author_name}. Available for research collaborations, consulting, and inquiries.`}
>
  <div class="space-y-24 pb-12">
    <!-- Header -->
    <section class="relative py-12 md:py-16 bg-abyss/80 -mt-20 pt-32 px-4 text-center">
      <NebulaGradient variant="subtle" />
      <div class="max-w-3xl mx-auto relative z-10 animate-fade-in">
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-surface border border-white/10 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent-500"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path></svg>
          <span class="text-sm font-medium text-secondary-300">Get in Touch</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold font-serif text-secondary-50 mb-6">
          Let's <span class="text-gradient-cyan">Connect</span>
        </h1>
        <p class="text-lg md:text-xl text-secondary-300 max-w-2xl mx-auto leading-relaxed">
          I'm always open to discussing new projects, research ideas, or opportunities to collaborate.
        </p>
      </div>
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-10 left-10 w-64 h-64 bg-primary-500/5 rounded-full blur-3xl"></div>
        <div class="absolute bottom-10 right-10 w-64 h-64 bg-accent-500/5 rounded-full blur-3xl"></div>
      </div>
    </section>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl">
      <!-- Availability -->
      <div class="bg-green-500/5 border border-green-500/20 rounded-2xl p-6 mb-12">
        <div class="flex items-start gap-4">
          <div class="bg-green-500/10 rounded-xl p-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-400"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div>
            <h3 class="font-semibold text-secondary-50 mb-1">Currently Available</h3>
            <p class="text-sm text-secondary-400">
              I usually respond within <span class="text-green-400 font-semibold">24-48 hours</span> during business days.
            </p>
          </div>
        </div>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-24">
        <!-- Contact Form -->
        <div>
          <h2 class="text-2xl font-bold font-serif text-secondary-50 mb-8 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-500"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
            Send a Message
          </h2>
          <ContactForm
            client:visible
            formspreeEndpoint={formspreeEndpoint}
            contactEmail={settings.social_email}
          />
        </div>

        <!-- Social & FAQ -->
        <div class="space-y-12">
          <div>
            <h2 class="text-2xl font-bold font-serif text-secondary-50 mb-8">Connect Elsewhere</h2>
            <div class="space-y-4">
              <a href={`mailto:${settings.social_email}`} class="block p-6 bg-gradient-to-br from-primary-600 to-indigo-700 text-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 group relative overflow-hidden hover:-translate-y-1">
                <div class="absolute top-0 right-0 p-3 bg-white/10 rounded-bl-2xl backdrop-blur-sm">
                  <span class="text-xs font-bold tracking-wider">PREFERRED</span>
                </div>
                <div class="flex items-start gap-4">
                  <div class="p-3 bg-white/20 rounded-xl backdrop-blur-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
                  </div>
                  <div>
                    <h3 class="font-bold text-lg mb-1">Email</h3>
                    <p class="text-sm text-white/90 mb-2">Best for professional inquiries</p>
                    <p class="text-sm font-mono text-white/80 bg-black/20 inline-block px-2 py-1 rounded">{settings.social_email}</p>
                  </div>
                </div>
              </a>

              {settings.social_github && (
                <a href={settings.social_github} target="_blank" rel="noopener noreferrer" class="block p-6 bg-surface text-secondary-200 rounded-2xl shadow-md hover:shadow-lg transition-all duration-300 hover:-translate-y-1 border border-white/[0.06] hover:border-primary-500/20">
                  <div class="flex items-start gap-4">
                    <div class="p-3 bg-white/10 rounded-xl">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
                    </div>
                    <div>
                      <h3 class="font-bold text-lg mb-1">GitHub</h3>
                      <p class="text-sm text-secondary-400">Check out my open-source work</p>
                    </div>
                  </div>
                </a>
              )}

              {settings.social_linkedin && (
                <a href={settings.social_linkedin} target="_blank" rel="noopener noreferrer" class="block p-6 bg-[#0077b5] text-white rounded-2xl shadow-md hover:shadow-lg transition-all duration-300 hover:-translate-y-1">
                  <div class="flex items-start gap-4">
                    <div class="p-3 bg-white/20 rounded-xl">
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                    </div>
                    <div>
                      <h3 class="font-bold text-lg mb-1">LinkedIn</h3>
                      <p class="text-sm text-white/90">Connect professionally</p>
                    </div>
                  </div>
                </a>
              )}
            </div>
          </div>

          <!-- FAQ -->
          <div>
            <h2 class="text-2xl font-bold font-serif text-secondary-50 mb-8">Frequently Asked Questions</h2>
            <div class="space-y-4">
              {faqs.map((faq) => (
                <details class="bg-surface border border-white/[0.06] rounded-xl overflow-hidden group">
                  <summary class="px-6 py-4 cursor-pointer flex items-center justify-between hover:bg-white/5 transition-colors list-none">
                    <span class="font-semibold text-secondary-50 pr-4">{faq.question}</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-secondary-400 flex-shrink-0 transition-transform duration-300 group-open:rotate-180"><path d="m6 9 6 6 6-6"></path></svg>
                  </summary>
                  <div class="px-6 pb-4 text-secondary-300">
                    {faq.answer}
                  </div>
                </details>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
