---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/astro/BlogCard.astro';
import { getPublishedPosts } from '@/lib/supabase';

const posts = await getPublishedPosts();

// Pre-build search index as JSON
const searchIndex = posts.map((p) => ({
  slug: p.slug,
  title: p.title,
  excerpt: p.excerpt,
  category: p.category,
  tags: p.tags,
  date: p.date,
  coverImage: p.coverImage || '',
  content: p.content.slice(0, 500),
}));
---

<BaseLayout title="Search" description="Search articles by title, content, tags, or category.">
  <div class="pb-12">
    <section class="relative py-12 md:py-16 bg-abyss/80 -mt-20 pt-32 px-4 text-center">
      <div class="max-w-3xl mx-auto relative z-10">
        <h1 class="text-4xl md:text-5xl font-bold font-serif text-secondary-50 mb-6">
          Search <span class="text-gradient-cyan">Articles</span>
        </h1>
        <div class="relative max-w-xl mx-auto">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-4 top-1/2 -translate-y-1/2 text-secondary-400 pointer-events-none"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
          <input
            id="search-input"
            type="search"
            aria-label="Search articles"
            placeholder="Search by title, tag, or keyword..."
            class="w-full pl-12 pr-4 py-4 rounded-2xl bg-surface border border-white/10 text-secondary-200 placeholder-secondary-500 focus:outline-none focus:border-primary-500/50 focus:shadow-glow-cyan shadow-lg text-lg"
            autocomplete="off"
          />
          <kbd class="hidden sm:flex items-center absolute right-4 top-1/2 -translate-y-1/2 px-2 py-1 text-xs text-secondary-500 bg-surface rounded border border-white/10">
            Esc
          </kbd>
        </div>
        <div class="mt-4 flex flex-wrap justify-center gap-2" role="group" aria-label="Search scope">
          <button type="button" data-search-scope="all" aria-pressed="true" class="search-scope-btn px-3 py-1.5 rounded-full text-sm font-medium bg-primary-500/20 text-primary-300 border border-primary-500/30">
            All
          </button>
          <button type="button" data-search-scope="title" aria-pressed="false" class="search-scope-btn px-3 py-1.5 rounded-full text-sm font-medium bg-white/5 text-secondary-400 border border-white/10 hover:border-primary-500/20 hover:text-secondary-200">
            Title
          </button>
          <button type="button" data-search-scope="tags" aria-pressed="false" class="search-scope-btn px-3 py-1.5 rounded-full text-sm font-medium bg-white/5 text-secondary-400 border border-white/10 hover:border-primary-500/20 hover:text-secondary-200">
            Tags
          </button>
          <button type="button" data-search-scope="content" aria-pressed="false" class="search-scope-btn px-3 py-1.5 rounded-full text-sm font-medium bg-white/5 text-secondary-400 border border-white/10 hover:border-primary-500/20 hover:text-secondary-200">
            Content
          </button>
        </div>
      </div>
    </section>

    <div class="container mx-auto px-4 sm:px-6 lg:px-8 max-w-6xl mt-12">
      <div id="search-status" role="status" aria-live="polite" class="text-center text-secondary-400 mb-8">
        Start typing to search across {posts.length} articles
      </div>
      <div id="search-intent" class="text-center py-16">
        <p class="text-secondary-400">Try a topic, tag, or keyword to find relevant posts quickly.</p>
      </div>
      <div id="search-results" class="hidden grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <div class="search-result-item" data-search-item>
            <BlogCard post={post} />
          </div>
        ))}
      </div>
      <div id="no-results" class="text-center py-20 hidden">
        <div class="text-6xl mb-6">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto text-secondary-600"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path><path d="M8 11h6"></path></svg>
        </div>
        <h2 class="text-2xl font-bold text-secondary-50 mb-4">No results found</h2>
        <p class="text-secondary-400">Try searching with different keywords.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ searchIndex }}>
  const input = document.getElementById('search-input');
  const statusEl = document.getElementById('search-status');
  const resultsContainer = document.getElementById('search-results');
  const intentState = document.getElementById('search-intent');
  const noResults = document.getElementById('no-results');
  const items = document.querySelectorAll('[data-search-item]');
  const scopeButtons = document.querySelectorAll('[data-search-scope]');
  const totalCount = searchIndex.length;
  let currentScope = 'all';

  function performSearch(query) {
    const q = query.toLowerCase().trim();

    if (!q) {
      items.forEach((item) => (item.style.display = ''));
      items.forEach((item) => (item.style.order = '0'));
      resultsContainer.classList.add('hidden');
      intentState.classList.remove('hidden');
      noResults.classList.add('hidden');
      statusEl.textContent = `Start typing to search across ${totalCount} articles`;
      return;
    }

    resultsContainer.classList.remove('hidden');
    intentState.classList.add('hidden');

    let visibleCount = 0;
    searchIndex.forEach((entry, i) => {
      const title = entry.title.toLowerCase();
      const excerpt = entry.excerpt.toLowerCase();
      const category = entry.category.toLowerCase();
      const tags = (entry.tags || []).join(' ').toLowerCase();
      const content = entry.content.toLowerCase();

      const scopeMap = {
        all: `${title} ${excerpt} ${category} ${tags} ${content}`,
        title,
        tags,
        content: `${content} ${excerpt}`,
      };

      const haystack = scopeMap[currentScope] ?? scopeMap.all;
      const matches = haystack.includes(q);
      let score = 0;
      if (matches) {
        if (title.includes(q)) score += 3;
        if (tags.includes(q)) score += 2;
        if (excerpt.includes(q) || content.includes(q)) score += 1;
      }

      items[i].style.display = matches ? '' : 'none';
      items[i].style.order = `${Math.max(0, 100 - score)}`;
      if (matches) visibleCount++;
    });

    statusEl.textContent = `${visibleCount} ${visibleCount === 1 ? 'result' : 'results'} in ${currentScope} for "${query}"`;
    noResults.classList.toggle('hidden', visibleCount > 0);
    resultsContainer.classList.toggle('hidden', visibleCount === 0);
  }

  input.addEventListener('input', (e) => performSearch(e.target.value));

  scopeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      currentScope = btn.getAttribute('data-search-scope') || 'all';
      scopeButtons.forEach((b) => {
        const active = (b.getAttribute('data-search-scope') || 'all') === currentScope;
        b.setAttribute('aria-pressed', active ? 'true' : 'false');
        b.className = active
          ? 'search-scope-btn px-3 py-1.5 rounded-full text-sm font-medium bg-primary-500/20 text-primary-300 border border-primary-500/30'
          : 'search-scope-btn px-3 py-1.5 rounded-full text-sm font-medium bg-white/5 text-secondary-400 border border-white/10 hover:border-primary-500/20 hover:text-secondary-200';
      });
      performSearch(input.value);
    });
  });

  // Keyboard shortcut: Escape clears search
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      e.target.value = '';
      performSearch('');
    }
  });

  // Focus search input on Cmd/Ctrl+K
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      input.focus();
      input.select();
    }
  });

  // Check URL params for initial query
  const params = new URL(window.location.href).searchParams;
  const initialQuery = params.get('q');
  if (initialQuery) {
    input.value = initialQuery;
    performSearch(initialQuery);
  }
</script>
