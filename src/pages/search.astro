---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/astro/BlogCard.astro';
import { getPublishedPosts } from '@/lib/supabase';

const posts = await getPublishedPosts();

const searchIndex = posts.map((post) => ({
  slug: post.slug,
  title: post.title,
  excerpt: post.excerpt,
  category: post.category,
  tags: post.tags,
  date: post.date,
  content: post.content.slice(0, 600),
}));
---

<BaseLayout title="Search the Journal" description="Search essays, categories, tags, and topics across the journal.">
  <div class="pb-16">
    <section class="page-hero">
      <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:items-end">
          <div class="max-w-3xl">
            <span class="section-eyebrow">Search</span>
            <h1 class="section-heading mt-6">
              Find a concept, essay, or topic thread without digging through the archive manually.
            </h1>
            <p class="section-copy mt-6 max-w-2xl">
              Search works best when you think in topics: terms, models, categories, or questions you want answered.
            </p>
          </div>
          <div class="surface-panel p-6">
            <p class="editorial-kicker">Search scope</p>
            <div class="mt-4 space-y-3 text-sm leading-7 text-secondary-300">
              <p>{posts.length} indexed essays</p>
              <p>Search across title, tags, content, or everything at once</p>
              <p>Use <span class="font-semibold text-secondary-100">Esc</span> to clear and <span class="font-semibold text-secondary-100">Ctrl/Cmd+K</span> to focus</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-shell section-break-sm">
      <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="surface-panel-strong p-5 sm:p-6">
          <div class="grid gap-5 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center">
            <div class="relative">
              <input
                id="search-input"
                type="search"
                aria-label="Search articles"
                placeholder="Search topics, categories, tags, or keywords"
                class="input-cosmic w-full pl-4 pr-14 py-4 text-base"
                autocomplete="off"
              />
              <kbd class="absolute right-4 top-1/2 hidden -translate-y-1/2 rounded-lg border border-white/10 bg-white/5 px-2 py-1 text-xs text-secondary-500 sm:inline-flex">
                Esc
              </kbd>
            </div>

            <div class="flex flex-wrap gap-2" role="group" aria-label="Search scope">
              <button type="button" data-search-scope="all" aria-pressed="true" class="search-scope-btn rounded-full border border-primary-500/30 bg-primary-500/20 px-4 py-2 text-sm font-medium text-primary-100">
                All
              </button>
              <button type="button" data-search-scope="title" aria-pressed="false" class="search-scope-btn rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-secondary-300 hover:border-primary-500/20 hover:text-primary-100">
                Title
              </button>
              <button type="button" data-search-scope="tags" aria-pressed="false" class="search-scope-btn rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-secondary-300 hover:border-primary-500/20 hover:text-primary-100">
                Tags
              </button>
              <button type="button" data-search-scope="content" aria-pressed="false" class="search-scope-btn rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-secondary-300 hover:border-primary-500/20 hover:text-primary-100">
                Content
              </button>
            </div>
          </div>
        </div>

        <div class="mt-8 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
          <p id="search-status" role="status" aria-live="polite" class="text-sm text-secondary-400">
            Start typing to search across {posts.length} indexed essays
          </p>
        </div>

        <div id="search-intent" class="surface-panel mt-8 p-8 text-center sm:p-12">
          <p class="editorial-kicker">Intent-first search</p>
          <h2 class="mt-3 font-serif text-3xl text-secondary-50">Start with a concept, not a page title</h2>
          <p class="mx-auto mt-4 max-w-2xl text-secondary-400">
            Try queries like <span class="text-secondary-200">machine learning</span>, <span class="text-secondary-200">artificial intelligence</span>, or a tag you remember from a previous essay.
          </p>
        </div>

        <div id="search-results" class="mt-8 hidden grid gap-6 md:grid-cols-2">
          {posts.map((post) => (
            <div class="search-result-item card-lift" data-search-item>
              <BlogCard post={post} compact={true} />
            </div>
          ))}
        </div>

        <div id="no-results" class="surface-panel mt-8 hidden p-8 text-center sm:p-12">
          <h2 class="font-serif text-3xl text-secondary-50">No matching essays</h2>
          <p class="mt-4 text-secondary-400">
            Try broadening the query, switching the scope, or searching by category or tag.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script define:vars={{ searchIndex }}>
  const input = document.getElementById('search-input');
  const statusEl = document.getElementById('search-status');
  const resultsContainer = document.getElementById('search-results');
  const intentState = document.getElementById('search-intent');
  const noResults = document.getElementById('no-results');
  const items = document.querySelectorAll('[data-search-item]');
  const scopeButtons = document.querySelectorAll('[data-search-scope]');
  const totalCount = searchIndex.length;
  let currentScope = 'all';

  function performSearch(query) {
    const q = query.toLowerCase().trim();

    if (!q) {
      items.forEach((item) => {
        item.style.display = '';
        item.style.order = '0';
        item.classList.remove('search-result-enter');
      });
      resultsContainer.classList.add('hidden');
      intentState.classList.remove('hidden');
      noResults.classList.add('hidden');
      statusEl.textContent = `Start typing to search across ${totalCount} indexed essays`;
      return;
    }

    resultsContainer.classList.remove('hidden');
    intentState.classList.add('hidden');

    let visibleCount = 0;
    searchIndex.forEach((entry, index) => {
      const title = entry.title.toLowerCase();
      const excerpt = entry.excerpt.toLowerCase();
      const category = entry.category.toLowerCase();
      const tags = (entry.tags || []).join(' ').toLowerCase();
      const content = entry.content.toLowerCase();

      const scopeMap = {
        all: `${title} ${excerpt} ${category} ${tags} ${content}`,
        title,
        tags,
        content: `${content} ${excerpt}`,
      };

      const haystack = scopeMap[currentScope] ?? scopeMap.all;
      const matches = haystack.includes(q);

      let score = 0;
      if (matches) {
        if (title.includes(q)) score += 4;
        if (tags.includes(q)) score += 3;
        if (category.includes(q)) score += 2;
        if (excerpt.includes(q) || content.includes(q)) score += 1;
      }

      items[index].style.display = matches ? '' : 'none';
      items[index].style.order = `${Math.max(0, 100 - score)}`;
      if (matches) {
        items[index].classList.add('search-result-enter');
        items[index].style.animationDelay = `${visibleCount * 50}ms`;
        visibleCount++;
      } else {
        items[index].classList.remove('search-result-enter');
      }
    });

    statusEl.textContent = `${visibleCount} ${visibleCount === 1 ? 'result' : 'results'} in ${currentScope} for "${query}"`;
    noResults.classList.toggle('hidden', visibleCount > 0);
    resultsContainer.classList.toggle('hidden', visibleCount === 0);
  }

  input?.addEventListener('input', (event) => performSearch((event.target as HTMLInputElement).value));

  scopeButtons.forEach((button) => {
    button.addEventListener('click', () => {
      currentScope = button.getAttribute('data-search-scope') || 'all';
      scopeButtons.forEach((candidate) => {
        const active = (candidate.getAttribute('data-search-scope') || 'all') === currentScope;
        candidate.setAttribute('aria-pressed', active ? 'true' : 'false');
        candidate.className = active
          ? 'search-scope-btn rounded-full border border-primary-500/30 bg-primary-500/20 px-4 py-2 text-sm font-medium text-primary-100'
          : 'search-scope-btn rounded-full border border-white/10 bg-white/5 px-4 py-2 text-sm font-medium text-secondary-300 hover:border-primary-500/20 hover:text-primary-100';
      });
      performSearch((input as HTMLInputElement).value);
    });
  });

  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      (event.target as HTMLInputElement).value = '';
      performSearch('');
    }
  });

  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key === 'k') {
      event.preventDefault();
      input?.focus();
      input?.select();
    }
  });

  const params = new URL(window.location.href).searchParams;
  const initialQuery = params.get('q');
  if (initialQuery && input) {
    input.value = initialQuery;
    performSearch(initialQuery);
  }
</script>
