---
// Admin panel - single page that hosts the entire admin React SPA
// Uses client:only="react" so everything runs purely on the client (no SSR)
// The admin SPA uses HashRouter internally, so no server-side routing needed
import AdminApp from '@/components/react/admin/AdminApp';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin | Mahir Faysal Tushar Blog</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Playfair+Display:wght@400;700&display=swap"
    />

    <!-- Admin is always dark mode -->
    <script is:inline>
      document.documentElement.classList.add('dark');
    </script>

    <style>
      body {
        margin: 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        background: #030014;
        color: #f1f5f9;
      }
      .admin-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        background: #030014;
        gap: 16px;
      }
      .admin-spinner {
        width: 48px;
        height: 48px;
        border: 3px solid rgba(6, 182, 212, 0.15);
        border-top-color: #06b6d4;
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
        box-shadow: 0 0 20px rgba(6, 182, 212, 0.2);
      }
      .admin-loading-text {
        font-size: 14px;
        color: rgba(148, 163, 184, 0.6);
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
    </style>
  </head>
  <body>
    <div id="admin-root">
      <div class="admin-loading">
        <div class="admin-spinner"></div>
        <div class="admin-loading-text">Loading admin panel...</div>
      </div>
    </div>
    <AdminApp client:only="react" />
  </body>
</html>
