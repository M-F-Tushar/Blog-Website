---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/astro/BlogCard.astro';
import { getPublishedPosts } from '@/lib/supabase';

const posts = (await getPublishedPosts()).filter((post) => post.category === 'Active Learning');
---
<BaseLayout title="Active Learning | The Garden" description="Raw notes and study progress from what I am currently learning.">
  <div class="section-shell py-28">
    <div class="mb-8 max-w-3xl">
      <span class="section-eyebrow">The Garden</span>
      <h1 class="section-heading mt-6">Active Learning</h1>
      <p class="section-copy mt-6">Raw notes, partial understanding, and study traces from things I am learning right now.</p>
    </div>
    <div class="grid gap-5 lg:grid-cols-3">
      {posts.map((post) => <BlogCard post={post} hrefBase="/garden" compact />)}
    </div>
  </div>
</BaseLayout>
