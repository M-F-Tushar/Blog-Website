---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BlogCard from '@/components/astro/BlogCard.astro';
import { getPublishedPosts } from '@/lib/supabase';

const posts = (await getPublishedPosts()).filter((post) => post.category === 'Knowledge Synthesized');
---
<BaseLayout title="Knowledge Synthesized | The Garden" description="Polished explanations of concepts I understand well enough to explain clearly.">
  <div class="section-shell py-28">
    <div class="mb-8 max-w-3xl">
      <span class="section-eyebrow">The Garden</span>
      <h1 class="section-heading mt-6">Knowledge Synthesized</h1>
      <p class="section-copy mt-6">Polished notes and clearer explanations of ideas that have moved beyond first contact.</p>
    </div>
    <div class="grid gap-5 lg:grid-cols-3">
      {posts.map((post) => <BlogCard post={post} hrefBase="/garden" compact />)}
    </div>
  </div>
</BaseLayout>
