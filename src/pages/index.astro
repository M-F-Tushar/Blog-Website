---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/astro/BlogCard.astro';
import AnimatedSection from '../components/astro/AnimatedSection.astro';
import LeadStoryCard from '../components/astro/LeadStoryCard.astro';
import ReaderStartHere from '../components/astro/ReaderStartHere.astro';
import SectionRail from '../components/astro/SectionRail.astro';
import {
  getBookshelfEntries,
  getContactLinks,
  getPageSections,
  getProjects,
  getPublishedPosts,
  getSiteSettings,
  getStoryChapters,
} from '@/lib/supabase';
import {
  getKickerClass,
  getMetadataText,
  selectSectionItems,
} from '@/lib/pageSections';
import { getContactLinkDisplayValue, getContactLinkHref, isContactLinkExternal } from '@/lib/contactLinks';

const settings = await getSiteSettings();
const pageSections = await getPageSections('home');
const posts = await getPublishedPosts();
const projects = await getProjects();
const storyChapters = await getStoryChapters();
const bookshelfEntries = await getBookshelfEntries();
const contactLinks = await getContactLinks();

const heroSection = pageSections.find((section) => section.sectionKey === 'hero');
const focusSection = pageSections.find((section) => section.sectionKey === 'current-focus');
const featuredProjectSection = pageSections.find((section) => section.sectionKey === 'featured-project');
const latestNotesSection = pageSections.find((section) => section.sectionKey === 'latest-notes');
const storySection = pageSections.find((section) => section.sectionKey === 'story-preview');
const bookshelfSection = pageSections.find((section) => section.sectionKey === 'bookshelf-preview');
const connectSection = pageSections.find((section) => section.sectionKey === 'connect');

const storyPreview = storyChapters[0];
const heroPortraitUrl = settings.author_image?.trim() || '';
const authorInitials =
  settings.author_name
    ?.split(' ')
    .filter(Boolean)
    .map((part) => part[0]?.toUpperCase())
    .slice(0, 2)
    .join('') || 'MF';

const getProjectItems = (section: NonNullable<typeof featuredProjectSection>) =>
  selectSectionItems(projects, section, {
    isFeatured: (project) => project.isFeatured,
  });

const getPostItems = (section: NonNullable<typeof latestNotesSection>) =>
  selectSectionItems(posts, section, {
    fallbackFeaturedId: settings.featured_post_id,
  });

const spotlightProject = featuredProjectSection ? getProjectItems(featuredProjectSection)[0] : undefined;
const noteItems = latestNotesSection ? getPostItems(latestNotesSection) : [];
const leadNote = noteItems[0];
const supportingNotes = noteItems.slice(1, Math.min(noteItems.length, 4));
const spotlightBookshelf = bookshelfSection
  ? selectSectionItems(bookshelfEntries, bookshelfSection, {
      isFeatured: (entry) => entry.isFeatured,
      isPinned: (entry) => entry.isPinned,
    })[0]
  : undefined;
const visibleLinks = contactLinks
  .filter((link) => link.visible)
  .slice(0, connectSection?.maxItems || 3);
---

<BaseLayout title={settings.site_name} description={settings.site_description}>
  <div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>
  <div class="pb-16">
    {heroSection && (
      <section class="page-hero section-shell">
        <div class="mx-auto max-w-6xl pt-4 pb-10 md:pt-6 md:pb-16 lg:pt-8 lg:pb-20">
          <div class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
            <AnimatedSection preset={heroSection.animationPreset || 'hero-rise'} class="space-y-6">
              {heroSection.eyebrow && <span class="section-eyebrow">{heroSection.eyebrow}</span>}
              <h1 class="max-w-5xl font-serif text-5xl font-bold tracking-[-0.05em] text-secondary-50 md:text-7xl md:leading-[0.95]">
                {heroSection.title}
              </h1>
              {heroSection.subtitle && <p class="max-w-2xl text-lg text-secondary-300 md:text-xl">{heroSection.subtitle}</p>}
              {heroSection.body && <p class="max-w-2xl text-base leading-8 text-secondary-300">{heroSection.body}</p>}
              <div class="flex flex-col gap-4 sm:flex-row">
                {heroSection.primaryCtaLabel && heroSection.primaryCtaUrl && (
                  <a href={heroSection.primaryCtaUrl} class="btn-primary rounded-2xl">
                    {heroSection.primaryCtaLabel}
                  </a>
                )}
                {heroSection.secondaryCtaLabel && heroSection.secondaryCtaUrl && (
                  <a href={heroSection.secondaryCtaUrl} class="btn-secondary rounded-2xl">
                    {heroSection.secondaryCtaLabel}
                  </a>
                )}
              </div>
            </AnimatedSection>

            <div class="space-y-6">
              <AnimatedSection preset={heroSection.animationPreset || 'hero-rise'} index={1}>
                <div class="hero-portrait-card">
                  <div class="hero-portrait-shell">
                    {heroPortraitUrl ? (
                      <img
                        src={heroPortraitUrl}
                        alt={`${settings.author_name} portrait`}
                        class="hero-portrait-image"
                        loading="eager"
                      />
                    ) : (
                      <span class="hero-portrait-monogram">{authorInitials}</span>
                    )}
                  </div>
                  <div class="space-y-2 text-center lg:text-left">
                    <p class="editorial-kicker">Builder in public</p>
                    <h2 class="font-serif text-2xl text-secondary-50 md:text-3xl">
                      {settings.author_name}
                    </h2>
                    {settings.author_tagline && (
                      <p class="text-sm leading-7 text-secondary-300 md:text-base">
                        {settings.author_tagline}
                      </p>
                    )}
                  </div>
                </div>
              </AnimatedSection>

              <AnimatedSection preset={heroSection.animationPreset || 'hero-rise'} index={2}>
                <div class="surface-panel-strong p-6 md:p-7">
                  <p class="editorial-kicker mb-3">Mission</p>
                  <p class="text-base leading-8 text-secondary-200">{settings.author_bio}</p>
                </div>
              </AnimatedSection>
            </div>
          </div>
        </div>

        <AnimatedSection preset="cascade" index={3}>
          <div class="mt-10 grid gap-4 md:grid-cols-3">
            <div class="editorial-metric">
              <span class="text-xs uppercase tracking-[0.2em] text-secondary-500">Notes</span>
              <strong class="mt-2 block text-3xl font-semibold text-secondary-50">
                <span class="count-up" data-count={posts.length}>{posts.length}</span>
              </strong>
            </div>
            <div class="editorial-metric">
              <span class="text-xs uppercase tracking-[0.2em] text-secondary-500">Projects</span>
              <strong class="mt-2 block text-3xl font-semibold text-secondary-50">
                <span class="count-up" data-count={projects.length}>{projects.length}</span>
              </strong>
            </div>
            <div class="editorial-metric">
              <span class="text-xs uppercase tracking-[0.2em] text-secondary-500">Chapters</span>
              <strong class="mt-2 block text-3xl font-semibold text-secondary-50">
                <span class="count-up" data-count={storyChapters.length}>{storyChapters.length}</span>
              </strong>
            </div>
          </div>
        </AnimatedSection>
      </section>
    )}

    {focusSection && (
      <ReaderStartHere
        title={focusSection.title || 'If you are new, start with what is being learned now.'}
        body={focusSection.body}
        eyebrow={focusSection.eyebrow || 'Start here'}
        items={[
          'Begin with one project to understand the practical direction.',
          'Read one Garden note to see how the learning is happening in public.',
          'Use Story and Bookshelf next if you want the person behind the work.',
        ]}
        href={heroSection?.primaryCtaUrl || '/garden'}
        label={heroSection?.primaryCtaLabel || 'Enter the garden'}
        animationPreset={focusSection.animationPreset || 'quiet-fade'}
      />
    )}

    <SectionRail
      eyebrow="Proof in motion"
      title="Start with one build and one note."
      body="The best way into the site is to see one system being built and one idea being worked through."
      weight="framed"
      frame="strong"
      tone="editorial"
      dividerBefore="star"
      role="proof"
    >
      <div class="grid gap-6 xl:grid-cols-2">
        {spotlightProject && (
          <LeadStoryCard
            eyebrow={`${featuredProjectSection?.eyebrow || 'Active build'} / ${spotlightProject.status}`}
            title={spotlightProject.title}
            summary={spotlightProject.description}
            href={`/lab/${spotlightProject.slug}`}
            ctaLabel="Read case study"
            meta={(spotlightProject.tags || spotlightProject.techStack).slice(0, 3)}
            tags={spotlightProject.techStack.slice(0, 3)}
            panelKicker={getMetadataText(featuredProjectSection || {}, 'panelKicker') || 'Why it matters'}
            panelBody={
              spotlightProject.motivation ||
              getMetadataText(featuredProjectSection || {}, 'panelBody') ||
              'This project shows the current intersection of product thinking, technical learning, and execution.'
            }
            accent="technical"
            animationPreset={featuredProjectSection?.animationPreset || 'rail-slide'}
          />
        )}

        {leadNote && (
          <LeadStoryCard
            eyebrow={`${latestNotesSection?.eyebrow || 'Lead note'} / ${leadNote.category}`}
            title={leadNote.title}
            summary={leadNote.excerpt}
            href={`/garden/${leadNote.slug}`}
            ctaLabel="Read note"
            meta={[leadNote.date]}
            tags={leadNote.tags.slice(0, 3)}
            panelKicker="Currently learning"
            panelBody="This note is the quickest way to understand what I am studying or clarifying right now."
            accent="editorial"
            animationPreset={latestNotesSection?.animationPreset || 'rail-slide'}
            index={1}
          />
        )}
      </div>

      {supportingNotes.length > 0 && (
        <div class="mt-6 grid gap-5 lg:grid-cols-3">
          {supportingNotes.map((post, index) => (
            <AnimatedSection preset={latestNotesSection?.animationPreset || 'stagger-cards'} index={index}>
              <BlogCard post={post} hrefBase="/garden" compact />
            </AnimatedSection>
          ))}
        </div>
      )}
    </SectionRail>

    <SectionRail
      eyebrow="Explore next"
      title="Three good doors deeper into the platform."
      dividerBefore="constellation"
      role="guide"
    >
      <div class="grid gap-6 xl:grid-cols-3">
        {storySection && storyPreview && (
          <LeadStoryCard
            eyebrow={storySection.eyebrow || 'My Story'}
            title={storyPreview.title}
            summary={storyPreview.subtitle || storySection.body}
            href={storySection.primaryCtaUrl || '/story'}
            ctaLabel={storySection.primaryCtaLabel || 'Read my story'}
            panelKicker={getMetadataText(storySection, 'panelKicker') || storyPreview.periodLabel}
            panelBody={getMetadataText(storySection, 'panelBody') || 'Use Story when you want the narrative behind the work.'}
            accent="quiet"
            panelLayout="stacked"
            animationPreset={storySection.animationPreset || 'scale-reveal'}
          />
        )}

        {bookshelfSection && spotlightBookshelf && (
          <LeadStoryCard
            eyebrow={bookshelfSection.eyebrow || 'Bookshelf'}
            title={spotlightBookshelf.title}
            summary={spotlightBookshelf.summary}
            href={`/bookshelf/${spotlightBookshelf.slug}`}
            ctaLabel="Read reflection"
            meta={[spotlightBookshelf.bookTitle]}
            tags={spotlightBookshelf.tags.slice(0, 3)}
            panelKicker="Reading life"
            panelBody="Bookshelf is the quieter room of the site: reflection, narrative, and the books shaping how I think."
            accent="warm"
            panelLayout="stacked"
            animationPreset={bookshelfSection.animationPreset || 'scale-reveal'}
            index={1}
          />
        )}

        {connectSection && (
          <AnimatedSection preset={connectSection.animationPreset || 'scale-reveal'} index={2}>
            <article class="lead-story-card lead-story-card-warm lead-story-card-stacked">
              <div class="min-w-0">
                {connectSection.eyebrow && <p class:list={[getKickerClass(connectSection), 'mb-3']}>{connectSection.eyebrow}</p>}
                <h3 class="font-serif text-3xl text-secondary-50 md:text-4xl">{connectSection.title}</h3>
                {connectSection.body && <p class="mt-5 text-secondary-300">{connectSection.body}</p>}
                {connectSection.primaryCtaUrl && connectSection.primaryCtaLabel && (
                  <a href={connectSection.primaryCtaUrl} class="btn-primary mt-8 rounded-2xl">
                    {connectSection.primaryCtaLabel}
                  </a>
                )}
              </div>

              <aside class="surface-subtle min-w-0 p-6">
                <p class="editorial-kicker mb-3">Keep in touch</p>
                <div class="grid gap-3">
                  {visibleLinks.map((link) => (
                    <a
                      href={getContactLinkHref(link)}
                      target={isContactLinkExternal(link) ? '_blank' : undefined}
                      rel={isContactLinkExternal(link) ? 'noopener noreferrer' : undefined}
                      class="reader-start-note"
                    >
                      <span class="block font-semibold text-secondary-50">{link.label}</span>
                      <span class="mt-1 block text-sm text-secondary-400">
                        {link.description || getContactLinkDisplayValue(link)}
                      </span>
                    </a>
                  ))}
                </div>
              </aside>
            </article>
          </AnimatedSection>
        )}
      </div>
    </SectionRail>
  </div>
</BaseLayout>

<script>
  function initHomePage() {
    // Scroll progress bar
    const progressBar = document.getElementById('scroll-progress');
    if (progressBar) {
      const updateProgress = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        progressBar.style.width = `${progress}%`;
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }

    // Count-up animation
    const countElements = document.querySelectorAll<HTMLElement>('.count-up[data-count]');
    if (countElements.length === 0) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (prefersReducedMotion) return;

    const countObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target as HTMLElement;
          const target = parseInt(el.dataset.count || '0', 10);
          if (isNaN(target) || target === 0) return;

          let current = 0;
          const duration = 1200;
          const step = Math.max(1, Math.ceil(target / (duration / 16)));
          const animate = () => {
            current = Math.min(current + step, target);
            el.textContent = current.toString();
            if (current < target) requestAnimationFrame(animate);
          };
          requestAnimationFrame(animate);
          countObserver.unobserve(el);
        });
      },
      { threshold: 0.3 }
    );

    countElements.forEach((el) => countObserver.observe(el));
  }

  initHomePage();
  document.addEventListener('astro:page-load', initHomePage);
</script>
