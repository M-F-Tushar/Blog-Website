---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CosmicDivider from '@/components/astro/CosmicDivider.astro';
import { generatePersonSchema } from '@/lib/structured-data';
import { getSiteSettings, getCVEducation, getCVExperience, getCVCertifications, isPageVisible } from '@/lib/supabase';
import PageNotAvailable from '@/components/astro/PageNotAvailable.astro';

const siteUrl = Astro.site?.toString() || '';
const settings = await getSiteSettings();
const pageVisible = isPageVisible(settings, '/cv');
const personSchema = generatePersonSchema(
  { name: settings.author_name, email: settings.social_email, url: siteUrl },
  'AI/ML Researcher & CS Student'
);

const education = await getCVEducation();
const experience = await getCVExperience();
const certifications = await getCVCertifications();

// Group skills by level ranges for display
const skills = settings.skills || [];
---

{pageVisible ? (
<BaseLayout
  title="CV | Mahir Faysal Tushar"
  description="Curriculum Vitae - Education, experience, skills, and certifications of Mahir Faysal Tushar."
  structuredData={personSchema}
>
  <section class="max-w-4xl mx-auto px-4 py-12 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-bold font-serif text-secondary-50 mb-2">
        {settings.author_name}
      </h1>
      <p class="text-xl text-primary-400 font-medium mb-4">
        {settings.author_tagline}
      </p>
      <div class="flex flex-wrap justify-center gap-4 text-sm text-secondary-400">
        {settings.social_email && (
          <a href={`mailto:${settings.social_email}`} class="inline-flex items-center gap-1 hover:text-primary-400 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            {settings.social_email}
          </a>
        )}
        {settings.social_github && (
          <a href={`https://github.com/${settings.social_github}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-primary-400 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            {settings.social_github}
          </a>
        )}
        {settings.social_linkedin && (
          <a href={`https://linkedin.com/in/${settings.social_linkedin}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-primary-400 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
        )}
      </div>

      <!-- Download CV button -->
      <div class="mt-6">
        <button
          class="inline-flex items-center gap-2 px-6 py-3 bg-gold-600 hover:bg-gold-500 text-white rounded-lg transition-colors font-medium shadow-lg shadow-gold-500/20"
          onclick="window.print()"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download / Print CV
        </button>
      </div>
    </div>

    <!-- Education -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold font-serif text-secondary-100 mb-6 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-400"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
        Education
      </h2>
      <div class="space-y-6">
        {education.map((edu) => (
          <div class="glass-cosmic rounded-xl p-6 border border-white/[0.06]">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 mb-2">
              <div>
                <h3 class="text-lg font-semibold text-secondary-50">{edu.degree}{edu.field ? ` in ${edu.field}` : ''}</h3>
                <p class="text-primary-400 font-medium">{edu.institution}</p>
              </div>
              <span class="text-sm text-secondary-500 whitespace-nowrap">{edu.start_year} - {edu.end_year || 'Present'}</span>
            </div>
            {edu.description && <p class="text-secondary-300 text-sm mb-3">{edu.description}</p>}
            {edu.courses && edu.courses.length > 0 && (
              <div class="flex flex-wrap gap-1.5">
                {edu.courses.map((course) => (
                  <span class="bg-primary-500/10 text-primary-300 px-2 py-0.5 rounded-full text-xs">
                    {course}
                  </span>
                ))}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>

    <CosmicDivider variant="star" />

    <!-- Experience -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold font-serif text-secondary-100 mb-6 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-400"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
        Experience
      </h2>
      <div class="space-y-6">
        {experience.map((exp) => (
          <div class="glass-cosmic rounded-xl p-6 border border-white/[0.06]">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 mb-2">
              <div>
                <h3 class="text-lg font-semibold text-secondary-50">{exp.role}</h3>
                <p class="text-primary-400 font-medium">{exp.company}</p>
              </div>
              <span class="text-sm text-secondary-500 whitespace-nowrap">{exp.start_date} - {exp.is_current ? 'Present' : (exp.end_date || 'Present')}</span>
            </div>
            {exp.description && <p class="text-secondary-300 text-sm mb-3">{exp.description}</p>}
            {exp.highlights && exp.highlights.length > 0 && (
              <ul class="space-y-1">
                {exp.highlights.map((h) => (
                  <li class="text-sm text-secondary-300 flex items-start gap-2">
                    <span class="text-primary-500 mt-1.5">&#8226;</span>
                    {h}
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>

    <CosmicDivider variant="star" />

    <!-- Technical Skills -->
    {skills.length > 0 && (
    <div class="mb-12">
      <h2 class="text-2xl font-bold font-serif text-secondary-100 mb-6 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-400"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        Technical Skills
      </h2>
      <div class="glass-cosmic rounded-xl p-6 border border-white/[0.06]">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {skills.map((skill: any) => (
            <div class="flex items-center justify-between gap-3">
              <span class="text-secondary-200 text-sm font-medium">{skill.name}</span>
              <div class="flex-1 max-w-[100px] bg-white/5 rounded-full h-2 overflow-hidden">
                <div
                  class="bg-gradient-to-r from-primary-500 to-accent-500 h-full rounded-full"
                  style={`width: ${(skill.level / 5) * 100}%;`}
                />
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    )}

    <CosmicDivider variant="star" />

    <!-- Certifications -->
    {certifications.length > 0 && (
      <div class="mb-12">
        <h2 class="text-2xl font-bold font-serif text-secondary-100 mb-6 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-primary-400"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>
          Certifications & Awards
        </h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {certifications.map((cert) => (
            <div class="glass-cosmic rounded-xl p-4 border border-white/[0.06]">
              <h3 class="font-semibold text-secondary-50">
                {cert.url ? (
                  <a href={cert.url} target="_blank" rel="noopener noreferrer" class="hover:text-primary-400 transition-colors">
                    {cert.name}
                  </a>
                ) : cert.name}
              </h3>
              <p class="text-sm text-secondary-400">
                {cert.issuer} &middot; {cert.year}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Links -->
    <div class="text-center border-t border-white/[0.06] pt-8">
      <p class="text-secondary-400 text-sm">
        For more details, visit my
        <a href="/publications" class="text-primary-400 hover:underline">publications</a>,
        <a href="/projects" class="text-primary-400 hover:underline">projects</a>, or
        <a href="/blog" class="text-primary-400 hover:underline">blog</a>.
      </p>
    </div>
  </section>
</BaseLayout>
) : (
<PageNotAvailable pageTitle="CV" />
)}

<style>
  @media print {
    nav, footer, button, .no-print {
      display: none !important;
    }
    body {
      background: white !important;
      color: #111 !important;
    }
    section {
      max-width: 100%;
      padding: 0;
    }
  }
</style>
