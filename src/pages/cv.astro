---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AnimatedSection from '@/components/astro/AnimatedSection.astro';
import CosmicDivider from '@/components/astro/CosmicDivider.astro';
import { generatePersonSchema } from '@/lib/structured-data';
import { getSiteSettings, getCVEducation, getCVExperience, getCVCertifications, isPageVisible } from '@/lib/supabase';

const siteUrl = Astro.site?.toString() || '';
const settings = await getSiteSettings();
const pageVisible = isPageVisible(settings, '/cv');
const personSchema = generatePersonSchema(
  { name: settings.author_name, email: settings.social_email, url: siteUrl },
  'AI/ML Researcher & CS Student'
);

const education = await getCVEducation();
const experience = await getCVExperience();
const certifications = await getCVCertifications();
const skills = settings.skills || [];

function normalizeSocialUrl(value: string | undefined, type: 'github' | 'linkedin'): string | null {
  if (!value) return null;
  const raw = String(value).trim();
  if (!raw) return null;
  if (/^https?:\/\//i.test(raw)) return raw;

  if (type === 'github') {
    const handle = raw.replace(/^@/, '').replace(/^github\.com\//i, '');
    return `https://github.com/${handle}`;
  }

  const profile = raw
    .replace(/^@/, '')
    .replace(/^linkedin\.com\/in\//i, '')
    .replace(/^in\//i, '');
  return `https://linkedin.com/in/${profile}`;
}

const githubUrl = normalizeSocialUrl(settings.social_github, 'github');
const linkedinUrl = normalizeSocialUrl(settings.social_linkedin, 'linkedin');
---

{pageVisible ? (
  <BaseLayout
    title="CV | Mahir Faysal Tushar"
    description="Curriculum vitae, experience, education, and technical skills."
    structuredData={personSchema}
  >
    <div class="pb-16">
      <section class="page-hero">
        <div class="container mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
          <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_18rem] lg:items-end">
            <div>
              <span class="section-eyebrow">Curriculum vitae</span>
              <h1 class="mt-6 font-serif text-4xl leading-[1.05] text-secondary-50 sm:text-5xl">{settings.author_name}</h1>
              <p class="mt-4 text-lg text-primary-200">{settings.author_tagline}</p>
              <div class="mt-6 flex flex-wrap gap-3 text-sm text-secondary-400">
                {settings.social_email && <a href={`mailto:${settings.social_email}`} class="link-subtle">{settings.social_email}</a>}
                {githubUrl && <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="link-subtle">GitHub</a>}
                {linkedinUrl && <a href={linkedinUrl} target="_blank" rel="noopener noreferrer" class="link-subtle">LinkedIn</a>}
              </div>
            </div>

            <div class="surface-panel p-6">
              <p class="editorial-kicker">Recruiter-friendly</p>
              <div class="mt-4 space-y-4 text-sm leading-7 text-secondary-300">
                <p>Designed for quick scanning and clean printing.</p>
                <button class="btn-primary mt-2 w-full justify-center" onclick="window.print()">
                  Download / print CV
                </button>
              </div>
            </div>
          </div>
        </div>
      </section>

      <div class="section-shell">
        <CosmicDivider variant="star" />
      </div>

      <section class="section-shell section-break-sm">
        <div class="container mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 space-y-10">
          <AnimatedSection preset="rail-slide" index={0}>
          <section class="surface-panel p-7 sm:p-9">
            <div class="mb-6 flex items-end justify-between gap-4">
              <div>
                <p class="editorial-kicker">Experience</p>
                <h2 class="mt-2 font-serif text-3xl text-secondary-50">Professional work</h2>
              </div>
            </div>

            <div class="timeline-connector space-y-6">
              {experience.map((item) => (
                <article class="surface-subtle relative p-5">
                  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                      <h3 class="font-serif text-2xl text-secondary-50">{item.role}</h3>
                      <p class="mt-2 text-primary-200">{item.company}</p>
                    </div>
                    <span class="text-sm text-secondary-500">
                      {item.start_date} - {item.is_current ? 'Present' : item.end_date || 'Present'}
                    </span>
                  </div>
                  {item.description && <p class="mt-4 text-sm leading-7 text-secondary-300">{item.description}</p>}
                  {item.highlights && item.highlights.length > 0 && (
                    <ul class="mt-4 space-y-2">
                      {item.highlights.map((highlight) => (
                        <li class="flex gap-3 text-sm leading-7 text-secondary-300">
                          <span class="mt-[0.78rem] h-1.5 w-1.5 rounded-full bg-primary-300"></span>
                          <span>{highlight}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </article>
              ))}
            </div>
          </section>
          </AnimatedSection>

          <AnimatedSection preset="rail-slide" index={1}>
          <section class="surface-panel p-7 sm:p-9">
            <div class="mb-6">
              <p class="editorial-kicker">Education</p>
              <h2 class="mt-2 font-serif text-3xl text-secondary-50">Academic background</h2>
            </div>

            <div class="timeline-connector space-y-6">
              {education.map((item) => (
                <article class="surface-subtle relative p-5">
                  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                    <div>
                      <h3 class="font-serif text-2xl text-secondary-50">
                        {item.degree}{item.field ? ` in ${item.field}` : ''}
                      </h3>
                      <p class="mt-2 text-primary-200">{item.institution}</p>
                    </div>
                    <span class="text-sm text-secondary-500">
                      {item.start_year} - {item.end_year || 'Present'}
                    </span>
                  </div>
                  {item.description && <p class="mt-4 text-sm leading-7 text-secondary-300">{item.description}</p>}
                  {item.courses && item.courses.length > 0 && (
                    <div class="mt-4 flex flex-wrap gap-2">
                      {item.courses.map((course) => (
                        <span class="inline-flex rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-secondary-300">
                          {course}
                        </span>
                      ))}
                    </div>
                  )}
                </article>
              ))}
            </div>
          </section>
          </AnimatedSection>

          {skills.length > 0 && (
            <AnimatedSection preset="stagger-cards" index={2}>
            <section class="surface-panel p-7 sm:p-9">
              <div class="mb-6">
                <p class="editorial-kicker">Skills</p>
                <h2 class="mt-2 font-serif text-3xl text-secondary-50">Technical strengths</h2>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                {skills.map((skill: any) => (
                  <div class="surface-subtle p-5">
                    <div class="flex items-center justify-between gap-4">
                      <span class="font-medium text-secondary-50">{skill.name}</span>
                      <span class="text-sm text-secondary-500">{skill.level}/5</span>
                    </div>
                    <div class="mt-4 h-2 overflow-hidden rounded-full bg-white/6">
                      <div class="h-full rounded-full bg-gradient-to-r from-primary-400 to-accent-400" style={`width: ${(skill.level / 5) * 100}%`}></div>
                    </div>
                  </div>
                ))}
              </div>
            </section>
            </AnimatedSection>
          )}

          {certifications.length > 0 && (
            <AnimatedSection preset="cascade" index={3}>
            <section class="surface-panel p-7 sm:p-9">
              <div class="mb-6">
                <p class="editorial-kicker">Credentials</p>
                <h2 class="mt-2 font-serif text-3xl text-secondary-50">Certifications and awards</h2>
              </div>

              <div class="grid gap-4 sm:grid-cols-2">
                {certifications.map((certification) => (
                  <article class="surface-subtle p-5">
                    <h3 class="font-semibold text-secondary-50">
                      {certification.url ? (
                        <a href={certification.url} target="_blank" rel="noopener noreferrer" class="hover:text-primary-100">
                          {certification.name}
                        </a>
                      ) : (
                        certification.name
                      )}
                    </h3>
                    <p class="mt-2 text-sm leading-7 text-secondary-300">
                      {certification.issuer} • {certification.year}
                    </p>
                  </article>
                ))}
              </div>
            </section>
            </AnimatedSection>
          )}
        </div>
      </section>
    </div>
  </BaseLayout>
) : (
  <html><head><meta http-equiv="refresh" content="0;url=/" /></head><body></body></html>
)}

<style>
  @media print {
    nav,
    footer,
    button,
    .no-print {
      display: none !important;
    }

    body {
      background: white !important;
      color: #111 !important;
    }

    .surface-panel,
    .surface-subtle {
      border: 1px solid #d1d5db !important;
      background: white !important;
      box-shadow: none !important;
    }
  }
</style>
