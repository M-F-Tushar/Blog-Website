---
import BaseLayout from './BaseLayout.astro';
import GiscusComments from '@/components/astro/GiscusComments.astro';
import type { Post } from '@/lib/types';
import { slugify, getSiteSettings } from '@/lib/supabase';
import { calculateReadingTime, formatReadingTime } from '@/lib/reading-time';
import { generateBlogPostingSchema } from '@/lib/structured-data';

interface Props {
  post: Post;
  headings?: { depth: number; slug: string; text: string }[];
  relatedPosts?: Post[];
  prevPost?: Post | null;
  nextPost?: Post | null;
}

const { post, headings = [], relatedPosts = [], prevPost, nextPost } = Astro.props;
const settings = await getSiteSettings();
const readingTime = calculateReadingTime(post.content);
const tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);

const structuredData = generateBlogPostingSchema(
  post,
  'https://mahirfaysaltusherblog.is-a.dev',
  settings.site_name,
  { name: settings.author_name, email: settings.social_email }
);

const formattedDate = new Date(post.date).toLocaleDateString(undefined, {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout
  title={post.title}
  description={post.excerpt}
  image={post.coverImage}
  type="article"
  structuredData={structuredData}
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.25/dist/katex.min.css"
    integrity="sha384-BHmjR5PJgPMBjUWvJh6xEEj3GIKam2V3Y0RHfrq3LNpCR7LKsCkFmMCqV6U5BOA"
    crossorigin="anonymous"
  />

  <div id="reading-progress" class="pointer-events-none fixed left-0 right-0 top-0 z-[70] h-px bg-transparent">
    <div id="progress-bar" class="h-full bg-gradient-to-r from-primary-400 via-accent-400 to-gold-400 transition-[width] duration-150" style="width: 0%"></div>
  </div>

  <article class="pb-20">
    <header class="page-hero pb-14">
      <div class="container mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <a
            href={`/blog/categories/${slugify(post.category)}`}
            class="section-eyebrow mx-auto"
          >
            {post.category}
          </a>

          <h1 class="mt-6 font-serif text-4xl leading-[1.05] text-secondary-50 sm:text-5xl lg:text-6xl">
            {post.title}
          </h1>

          <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-secondary-300">
            {post.excerpt}
          </p>

          <div class="mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-sm text-secondary-400">
            <span>{settings.author_name}</span>
            <span class="hidden sm:inline text-secondary-600">•</span>
            <time datetime={post.date}>{formattedDate}</time>
            <span class="hidden sm:inline text-secondary-600">•</span>
            <span class="text-gold-300/90">{formatReadingTime(readingTime)}</span>
          </div>
        </div>
      </div>
    </header>

    {post.coverImage && (
      <section class="-mt-8 px-4 sm:px-6 lg:px-8">
        <div class="container mx-auto max-w-6xl">
          <div class="surface-panel overflow-hidden p-2">
            <img
              src={post.coverImage}
              alt={`Cover image for ${post.title}`}
              class="max-h-[34rem] w-full rounded-[1.35rem] object-cover"
              loading="eager"
              width="1600"
              height="900"
            />
          </div>
        </div>
      </section>
    )}

    <section class="section-shell">
      <div class="container mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
          <div class="min-w-0">
            <div class="surface-panel p-6 sm:p-8 lg:p-10">
              <div class="mb-8 flex flex-wrap gap-2">
                {post.tags?.map((tag) => (
                  <a
                    href={`/blog/tags/${tag}`}
                    class="inline-flex items-center rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-medium text-secondary-300 transition-colors hover:border-primary-500/30 hover:text-primary-100"
                  >
                    #{tag}
                  </a>
                ))}
              </div>

              <div
                class="prose prose-lg max-w-none prose-invert prose-headings:font-serif prose-headings:text-secondary-50 prose-headings:scroll-mt-28 prose-p:text-secondary-200 prose-p:leading-8 prose-a:text-primary-200 prose-a:no-underline hover:prose-a:text-primary-100 prose-strong:text-secondary-50 prose-code:text-primary-100 prose-code:before:content-none prose-code:after:content-none prose-pre:border prose-pre:border-white/10 prose-pre:bg-[#060b16] prose-pre:shadow-none prose-blockquote:border-l-primary-400 prose-blockquote:text-secondary-200 prose-hr:border-white/10 prose-li:text-secondary-200 prose-img:rounded-[1.35rem] prose-img:border prose-img:border-white/10 prose-table:block prose-table:w-full prose-table:overflow-x-auto"
              >
                <slot />
              </div>
            </div>

            <nav class="mt-10 grid gap-4 md:grid-cols-2" aria-label="Post navigation">
              {prevPost ? (
                <a href={`/blog/${prevPost.slug}`} class="surface-subtle p-5 transition-colors hover:border-primary-500/30">
                  <span class="text-xs uppercase tracking-[0.18em] text-secondary-500">Previous essay</span>
                  <p class="mt-3 font-serif text-xl text-secondary-50">{prevPost.title}</p>
                </a>
              ) : (
                <div></div>
              )}
              {nextPost && (
                <a href={`/blog/${nextPost.slug}`} class="surface-subtle p-5 text-left transition-colors hover:border-primary-500/30 md:text-right">
                  <span class="text-xs uppercase tracking-[0.18em] text-secondary-500">Next essay</span>
                  <p class="mt-3 font-serif text-xl text-secondary-50">{nextPost.title}</p>
                </a>
              )}
            </nav>

            {relatedPosts.length > 0 && (
              <section class="mt-14">
                <div class="mb-6 flex items-end justify-between gap-4">
                  <div>
                    <p class="editorial-kicker">Continue exploring</p>
                    <h2 class="mt-2 font-serif text-3xl text-secondary-50">Related essays</h2>
                  </div>
                </div>
                <div class="grid gap-5 md:grid-cols-2">
                  {relatedPosts.slice(0, 2).map((related) => (
                    <a href={`/blog/${related.slug}`} class="surface-subtle p-6 transition-colors hover:border-primary-500/30">
                      <span class="text-xs uppercase tracking-[0.18em] text-primary-200">{related.category}</span>
                      <h3 class="mt-3 font-serif text-2xl text-secondary-50">{related.title}</h3>
                      <p class="mt-3 text-sm leading-7 text-secondary-300">{related.excerpt}</p>
                    </a>
                  ))}
                </div>
              </section>
            )}

            <div class="mt-14">
              <GiscusComments />
            </div>
          </div>

          {tocHeadings.length > 0 && (
            <aside class="hidden lg:block">
              <div class="sticky top-28 surface-panel p-5">
                <p class="editorial-kicker">On this page</p>
                <nav aria-label="Table of contents" class="mt-5">
                  <ul class="space-y-2">
                    {tocHeadings.map((heading) => (
                      <li>
                        <a
                          href={`#${heading.slug}`}
                          class:list={[
                            'toc-link block rounded-xl border border-transparent px-3 py-2 text-sm leading-6 text-secondary-400 transition-colors hover:text-primary-100',
                            heading.depth === 3 ? 'ml-4 text-[0.9rem]' : '',
                          ]}
                          data-toc-link
                          data-heading-id={heading.slug}
                        >
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            </aside>
          )}
        </div>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  const progressBar = document.getElementById('progress-bar');
  if (progressBar) {
    window.addEventListener('scroll', () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      progressBar.style.width = `${Math.min(100, progress)}%`;
    });
  }

  const tocLinks = document.querySelectorAll('[data-toc-link]');
  if (tocLinks.length > 0) {
    const headingIds = Array.from(tocLinks).map((link) => link.getAttribute('data-heading-id') || '');
    const headingElements = headingIds
      .map((id) => document.getElementById(id))
      .filter(Boolean) as HTMLElement[];

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          tocLinks.forEach((link) => {
            link.classList.remove('bg-white/5', 'border-white/10', 'text-primary-100');
          });

          const activeLink = document.querySelector(`[data-heading-id="${entry.target.id}"]`);
          if (activeLink) {
            activeLink.classList.add('bg-white/5', 'border-white/10', 'text-primary-100');
          }
        });
      },
      { rootMargin: '-96px 0px -70% 0px', threshold: 0 }
    );

    headingElements.forEach((element) => observer.observe(element));
  }
</script>
