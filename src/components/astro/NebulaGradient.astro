---
interface Props {
  variant?: 'hero' | 'section' | 'subtle';
  class?: string;
}

const { variant = 'hero', class: className } = Astro.props;

const config = {
  hero: {
    blob1Opacity: 0.15,
    blob2Opacity: 0.13,
    blob3Opacity: 0.12,
    blur: 'blur(64px)',   /* Tailwind blur-3xl equivalent */
    size: '24rem',        /* w-96 h-96 */
  },
  section: {
    blob1Opacity: 0.10,
    blob2Opacity: 0.09,
    blob3Opacity: 0.08,
    blur: 'blur(40px)',   /* Tailwind blur-2xl equivalent */
    size: '18rem',        /* w-72 h-72 */
  },
  subtle: {
    blob1Opacity: 0.06,
    blob2Opacity: 0.05,
    blob3Opacity: 0.04,
    blur: 'blur(24px)',   /* Tailwind blur-xl equivalent */
    size: '12rem',        /* w-48 h-48 */
  },
};

const c = config[variant];

/* Pre-build each blob's inline styles to keep the template readable. */
const blob1Style = [
  'left: 30%',
  'top: 40%',
  `width: ${c.size}`,
  `height: ${c.size}`,
  `background: radial-gradient(circle, rgba(139, 92, 246, ${c.blob1Opacity}) 0%, transparent 70%)`,
  `filter: ${c.blur}`,
  'animation-delay: 0s',
].join('; ');

const blob2Style = [
  'left: 70%',
  'top: 60%',
  `width: ${c.size}`,
  `height: ${c.size}`,
  `background: radial-gradient(circle, rgba(6, 182, 212, ${c.blob2Opacity}) 0%, transparent 70%)`,
  `filter: ${c.blur}`,
  'animation-delay: 2s',
].join('; ');

const blob3Style = [
  'left: 50%',
  'top: 80%',
  `width: ${c.size}`,
  `height: ${c.size}`,
  `background: radial-gradient(circle, rgba(236, 72, 153, ${c.blob3Opacity}) 0%, transparent 70%)`,
  `filter: ${c.blur}`,
  'animation-delay: 4s',
].join('; ');
---

<div class:list={['nebula-gradient', className]} aria-hidden="true">
  <div class="nebula-blob nebula-blob--violet" style={blob1Style} />
  <div class="nebula-blob nebula-blob--cyan"   style={blob2Style} />
  <div class="nebula-blob nebula-blob--pink"   style={blob3Style} />
</div>

<style>
  .nebula-gradient {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .nebula-blob {
    position: absolute;
    border-radius: 50%;
    /* Centre the blob on its left/top anchor point */
    transform: translate(-50%, -50%);
    animation: blob 14s ease-in-out infinite;
  }

  @keyframes blob {
    0%, 100% {
      transform: translate(-50%, -50%) scale(1) translate(0, 0);
    }
    33% {
      transform: translate(-50%, -50%) scale(1.15) translate(30px, -40px);
    }
    66% {
      transform: translate(-50%, -50%) scale(0.9) translate(-20px, 20px);
    }
  }

  /* Respect reduced-motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .nebula-blob {
      animation: none;
    }
  }
</style>
