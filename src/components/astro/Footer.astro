---
import {
  getBookshelfEntries,
  getContactLinks,
  getNavigationItems,
  getPublishedPosts,
  getSiteSettings,
} from '@/lib/supabase';
import { getContactLinkHref, isContactLinkExternal } from '@/lib/contactLinks';

const settings = await getSiteSettings();
const navigationItems = await getNavigationItems();
const contactLinks = await getContactLinks();
const posts = await getPublishedPosts();
const bookshelf = await getBookshelfEntries();
const recentPosts = posts.slice(0, 2);
const featuredShelf = bookshelf.find((entry) => entry.isFeatured) || bookshelf[0];
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-white/[0.06] bg-[#040913]/90 text-secondary-300" role="contentinfo">
  <div class="section-shell py-16">
    <div class="grid gap-10 lg:grid-cols-[1.2fr_0.8fr_0.9fr]">
      <div class="space-y-6">
        <div class="space-y-3">
          <a href="/" class="font-serif text-[2rem] font-semibold tracking-[-0.04em] text-secondary-50">
            <span class="text-gradient-cyan">{settings.site_name}</span>
          </a>
          <p class="max-w-xl text-base text-secondary-300">
            {settings.site_description}
          </p>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          {contactLinks.map((link) => (
            <a
              href={getContactLinkHref(link)}
              target={isContactLinkExternal(link) ? '_blank' : undefined}
              rel={isContactLinkExternal(link) ? 'noopener noreferrer' : undefined}
              class="btn-ghost rounded-full px-4 py-2 text-sm hover:text-secondary-50"
            >
              {link.label}
            </a>
          ))}
        </div>
      </div>

      <div class="space-y-6">
        <div>
          <p class="editorial-kicker mb-4">Explore</p>
          <nav class="grid gap-2" aria-label="Footer navigation">
            {navigationItems.map((link) => (
              <a href={link.path} class="link-subtle justify-start">
                {link.label}
              </a>
            ))}
          </nav>
        </div>

        {recentPosts.length > 0 && (
          <div>
            <p class="editorial-kicker mb-4">Latest notes</p>
            <div class="space-y-3">
              {recentPosts.map((post) => (
                <a href={`/garden/${post.slug}`} class="block rounded-2xl border border-white/[0.06] bg-white/[0.03] px-4 py-3 transition-colors hover:border-primary-400/25 hover:bg-white/[0.05]">
                  <p class="text-sm font-semibold text-secondary-100">{post.title}</p>
                  <p class="mt-1 text-xs text-secondary-500">{post.category}</p>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <div class="surface-panel p-6">
        <p class="editorial-kicker mb-3">Bookshelf</p>
        {featuredShelf ? (
          <>
            <h3 class="mb-3 font-serif text-2xl font-semibold text-secondary-50">{featuredShelf.title}</h3>
            <p class="mb-5 text-sm text-secondary-300">{featuredShelf.summary}</p>
            <a href={`/bookshelf/${featuredShelf.slug}`} class="btn-primary rounded-2xl">Read reflection</a>
          </>
        ) : (
          <>
            <h3 class="mb-3 font-serif text-2xl font-semibold text-secondary-50">Connect</h3>
            <p class="mb-5 text-sm text-secondary-300">Follow the work through the garden, the lab, or a direct message.</p>
            <a href="/connect" class="btn-primary rounded-2xl">Open connect page</a>
          </>
        )}
      </div>
    </div>

    <div class="mt-12 flex flex-col gap-3 border-t border-white/[0.06] pt-6 text-sm text-secondary-500 md:flex-row md:items-center md:justify-between">
      <p>&copy; {currentYear} {settings.author_name}. Built as a long-term personal platform.</p>
      <div class="flex items-center gap-4">
        <a href="/rss.xml" class="transition-colors hover:text-primary-300">RSS</a>
        <button id="scroll-to-top" class="transition-colors hover:text-primary-300">Back to top</button>
      </div>
    </div>
  </div>
</footer>

<script>
  document.getElementById('scroll-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
