---
import { getSiteSettings, getPublishedPosts, getNavigationCustomPages } from '@/lib/supabase';
import ConstellationDecor from './ConstellationDecor.astro';

const settings = await getSiteSettings();
const uiText = (settings as any).ui_text?.footer || {};
const navigation = (settings as any).navigation;
const customPages = await getNavigationCustomPages();
const posts = await getPublishedPosts();
const recentPosts = posts.slice(0, 3);

const currentYear = new Date().getFullYear();

const defaultFooterLinks = [
  { path: '/', label: 'Home' },
  { path: '/about', label: 'About' },
  { path: '/blog', label: 'Blog' },
  { path: '/publications', label: 'Publications' },
  { path: '/projects', label: 'Projects' },
  { path: '/playground', label: 'Playground' },
  { path: '/cv', label: 'CV' },
  { path: '/contact', label: 'Contact' },
];

const menuItems = navigation?.menuItems;
const footerLinks = (menuItems && Array.isArray(menuItems) && menuItems.length > 0)
  ? menuItems
      .filter((item: any) => item.visible !== false && item.path && item.label)
      .sort((a: any, b: any) => (a.order || 0) - (b.order || 0))
      .map((item: any) => ({ path: item.path, label: item.label }))
  : defaultFooterLinks;

// Append custom pages that have show_in_navigation enabled
const customPageLinks = customPages.map((p) => ({ path: `/p/${p.slug}`, label: p.title }));
const allFooterLinks = [...footerLinks, ...customPageLinks];
---

<div class="h-[1px] bg-gradient-to-r from-transparent via-primary-500/30 to-transparent"></div>
<footer class="relative bg-abyss star-pattern text-secondary-300" role="contentinfo">
  <ConstellationDecor variant="right" class="absolute top-8 right-8 opacity-10 w-48 hidden lg:block" />
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 mb-12">
      <!-- Brand Column -->
      <div class="lg:col-span-4 space-y-6">
        <a href="/" class="text-gradient-cyan text-2xl font-bold font-serif tracking-tight">
          {settings.site_name}
        </a>
        <p class="text-secondary-400 leading-relaxed max-w-sm">
          {uiText.tagline || 'Exploring the frontiers of AI, machine learning, and technology. Join me on this journey of continuous learning and research.'}
        </p>
        <div class="flex items-center gap-4">
          {settings.social_github && (
            <a
              href={settings.social_github}
              target="_blank"
              rel="noopener noreferrer"
              class="p-3 bg-white/5 border border-white/10 hover:border-primary-500/50 hover:shadow-glow-cyan hover:text-primary-400 text-secondary-400 rounded-full transition-all duration-300"
              aria-label="Visit GitHub profile"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg>
            </a>
          )}
          {settings.social_linkedin && (
            <a
              href={settings.social_linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="p-3 bg-white/5 border border-white/10 hover:border-primary-500/50 hover:shadow-glow-cyan hover:text-primary-400 text-secondary-400 rounded-full transition-all duration-300"
              aria-label="Visit LinkedIn profile"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect width="4" height="12" x="2" y="9"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            </a>
          )}
          {settings.social_email && (
            <a
              href={`mailto:${settings.social_email}`}
              class="p-3 bg-white/5 border border-white/10 hover:border-primary-500/50 hover:shadow-glow-cyan hover:text-primary-400 text-secondary-400 rounded-full transition-all duration-300"
              aria-label="Send email"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            </a>
          )}
        </div>
      </div>

      <!-- Quick Links -->
      <div class="lg:col-span-2">
        <h3 class="text-secondary-50 font-semibold text-lg mb-6">{uiText.exploreTitle || 'Explore'}</h3>
        <nav class="space-y-3" aria-label="Footer navigation">
          {allFooterLinks.map((link) => (
            <a
              href={link.path}
              class="block text-secondary-400 hover:text-primary-400 hover:translate-x-1 transition-all duration-200"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Latest Articles -->
      <div class="lg:col-span-3">
        <h3 class="text-secondary-50 font-semibold text-lg mb-6">{uiText.latestTitle || 'Latest Articles'}</h3>
        <div class="space-y-4">
          {recentPosts.length > 0 ? (
            recentPosts.map((post) => (
              <a href={`/blog/${post.slug}`} class="group block">
                <h4 class="text-secondary-200 group-hover:text-primary-400 transition-colors line-clamp-2 font-medium">
                  {post.title}
                </h4>
                <p class="text-xs text-secondary-500 mt-1">
                  {new Date(post.date).toLocaleDateString(undefined, {
                    month: 'long',
                    day: 'numeric',
                    year: 'numeric',
                  })}
                </p>
              </a>
            ))
          ) : (
            <p class="text-sm text-secondary-500">No posts yet</p>
          )}
        </div>
      </div>

      <!-- Newsletter CTA -->
      <div class="lg:col-span-3">
        <h3 class="text-secondary-50 font-semibold text-lg mb-6">{uiText.stayConnectedTitle || 'Stay Connected'}</h3>
        <p class="text-sm text-secondary-400 mb-4">
          {uiText.newsletterDescription || 'Get the latest posts and updates delivered straight to your inbox.'}
        </p>
        <form class="space-y-3" action="#" method="POST">
          <div class="relative">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="absolute left-3 top-1/2 -translate-y-1/2 text-secondary-500"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            <input
              type="email"
              placeholder="your@email.com"
              class="w-full pl-10 pr-4 py-2.5 bg-surface border border-white/10 focus:border-primary-500/50 focus:shadow-[0_0_0_3px_rgba(6,182,212,0.1)] focus:outline-none rounded-lg text-sm text-secondary-200 placeholder-secondary-500 transition-all"
              aria-label="Email for newsletter"
            />
          </div>
          <button
            type="submit"
            class="w-full px-4 py-2.5 bg-primary-600 hover:bg-primary-500 text-white rounded-lg text-sm font-medium transition-all duration-200 flex items-center justify-center gap-2 shadow-lg shadow-primary-500/20 hover:shadow-primary-500/30"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
            {uiText.subscribeButton || 'Subscribe'}
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/5 pt-8 mt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-sm text-secondary-500">
        &copy; {currentYear} {settings.author_name}. {uiText.copyrightText || 'Built with Astro & React.'}
      </p>
      <div class="flex items-center gap-6">
        <a href="/rss.xml" class="text-sm text-secondary-500 hover:text-primary-400 transition-colors flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path><circle cx="5" cy="19" r="1"></circle></svg>
          RSS
        </a>
        <button
          id="scroll-to-top"
          class="text-sm text-secondary-500 hover:text-primary-400 hover:shadow-[0_-4px_12px_rgba(6,182,212,0.15)] transition-all duration-300 flex items-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"></path></svg>
          Back to Top
        </button>
      </div>
    </div>
  </div>
</footer>

<script>
  document.getElementById('scroll-to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>
