---
interface Props {
  color?: string;
  size?: number;
}

const { color = 'rgba(6,182,212,0.07)', size = 600 } = Astro.props;
---

<div
  id="cursor-glow"
  aria-hidden="true"
  style={`
    position: fixed;
    top: 0;
    left: 0;
    width: ${size}px;
    height: ${size}px;
    pointer-events: none;
    z-index: 1;
    background: radial-gradient(circle, ${color} 0%, transparent 70%);
    border-radius: 50%;
    will-change: transform;
    transform: translate(-100%, -100%);
    display: none;
  `}
></div>

<script define:vars={{ size }}>
  (function () {
    const el = document.getElementById('cursor-glow');
    if (!el) return;

    const pointerFine = window.matchMedia('(pointer: fine)').matches;
    const mqlMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (!pointerFine || mqlMotion.matches) return;

    el.style.display = '';

    const halfSize = size / 2;
    let x = 0;
    let y = 0;
    let raf = 0;

    function update() {
      el.style.transform = 'translate(' + (x - halfSize) + 'px, ' + (y - halfSize) + 'px)';
      raf = 0;
    }

    document.addEventListener('mousemove', function (e) {
      x = e.clientX;
      y = e.clientY;
      if (!raf) {
        raf = requestAnimationFrame(update);
      }
    }, { passive: true });

    mqlMotion.addEventListener('change', function (e) {
      el.style.display = e.matches ? 'none' : '';
    });
  })();
</script>
