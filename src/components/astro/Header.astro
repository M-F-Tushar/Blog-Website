---
import ThemeToggle from './ThemeToggle.astro';
import { getNavigationItems, getSiteSettings } from '@/lib/supabase';

const settings = await getSiteSettings();
const navItems = await getNavigationItems();
const currentPath = Astro.url.pathname;
const followHref = '/rss.xml';

const primaryNavLinks = navItems.filter((item) => item.visible);
---

<header id="site-header" class="relative z-50 px-3 pt-3 transition-all duration-300 sm:px-4">
  <nav class="section-shell" aria-label="Main navigation">
    <div
      id="site-header-shell"
      class="mx-auto flex max-w-7xl items-center gap-3 rounded-[1.75rem] border border-white/[0.08] bg-[#07111f]/88 px-4 py-3 shadow-[0_18px_50px_rgba(0,0,0,0.35)] backdrop-blur-xl transition-all duration-300"
    >
      <a
        href="/"
        class="shrink-0 font-serif text-[1.65rem] font-semibold tracking-[-0.04em] text-secondary-50 transition-opacity hover:opacity-90"
        aria-label={`${(settings as any).site_name || 'MFT'} - Home`}
      >
        <span class="text-gradient-cyan">{(settings as any).site_name || 'MFT'}</span>
      </a>

      <div class="hidden lg:flex lg:flex-1 lg:items-center lg:justify-center">
        <div class="flex items-center gap-1 rounded-full border border-white/[0.06] bg-white/[0.03] p-1">
          {primaryNavLinks.map((link) => {
            const isActive =
              currentPath === link.path || (link.path !== '/' && currentPath.startsWith(link.path));
            return (
              <a
                href={link.path}
                class:list={[
                  'rounded-full px-4 py-2 text-sm font-semibold transition-all duration-200',
                  isActive
                    ? 'bg-white/[0.08] text-secondary-50 shadow-[inset_0_1px_0_rgba(255,255,255,0.05)]'
                    : 'text-secondary-400 hover:text-secondary-100',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                {link.label}
              </a>
            );
          })}
        </div>
      </div>

      <div class="ml-auto flex items-center gap-2">
        <a
          href="/search"
          class="icon-btn text-secondary-300 hover:border-primary-400/30 hover:bg-white/[0.08] hover:text-secondary-50"
          aria-label="Open search page"
        >
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path></svg>
        </a>

        <a href={followHref} class="hidden sm:inline-flex btn-ghost rounded-full px-4 py-2 text-sm">
          Follow
        </a>

        <ThemeToggle />

        <button
          id="mobile-menu-btn"
          class="icon-btn lg:hidden text-secondary-300 hover:border-primary-400/30 hover:bg-white/[0.08] hover:text-secondary-50"
          aria-label="Open menu"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg id="menu-icon-open" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" x2="20" y1="12" y2="12"></line><line x1="4" x2="20" y1="6" y2="6"></line><line x1="4" x2="20" y1="18" y2="18"></line></svg>
          <svg id="menu-icon-close" aria-hidden="true" class="hidden" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg>
        </button>
      </div>
    </div>
  </nav>

  <div
    id="mobile-menu"
    class="section-shell pointer-events-none invisible absolute inset-x-0 top-full opacity-0 transition-all duration-200 lg:hidden"
    aria-hidden="true"
  >
    <div class="mx-auto mt-3 max-w-7xl rounded-[1.75rem] border border-white/[0.08] bg-[#091424]/96 p-4 shadow-[0_24px_80px_rgba(0,0,0,0.45)] backdrop-blur-xl">
      <nav aria-label="Mobile navigation" class="space-y-1">
        {primaryNavLinks.map((link) => {
          const isActive =
            currentPath === link.path || (link.path !== '/' && currentPath.startsWith(link.path));
          return (
            <a
              href={link.path}
              class:list={[
                'mobile-nav-link block rounded-2xl px-4 py-3 text-base font-semibold transition-colors',
                isActive
                  ? 'bg-white/[0.08] text-secondary-50'
                  : 'text-secondary-300 hover:bg-white/[0.05] hover:text-secondary-50',
              ]}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}

        <div class="mt-5 grid grid-cols-2 gap-3 border-t border-white/[0.06] pt-5">
          <a href="/search" class="btn-ghost justify-center rounded-2xl">Search</a>
          <a href={followHref} class="btn-primary justify-center rounded-2xl">Follow</a>
        </div>
      </nav>
    </div>
  </div>
</header>

<script>
  function initHeader() {
    const header = document.getElementById('site-header');
    const shell = document.getElementById('site-header-shell');
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    if (!header || !shell || !menuBtn || !mobileMenu || !iconOpen || !iconClose) return;

    if (header.dataset.initialized === 'true') return;
    header.dataset.initialized = 'true';

    const controller = new AbortController();
    const { signal } = controller;
    let isMenuOpen = false;

    function updateShellState() {
      if (window.scrollY > 10) shell.classList.add('border-white/[0.12]', 'bg-[#07101d]/94');
      else shell.classList.remove('border-white/[0.12]', 'bg-[#07101d]/94');
    }

    function closeMenu() {
      if (!isMenuOpen) return;
      isMenuOpen = false;
      mobileMenu.classList.add('pointer-events-none', 'invisible', 'opacity-0');
      mobileMenu.setAttribute('aria-hidden', 'true');
      menuBtn.setAttribute('aria-expanded', 'false');
      iconOpen.classList.remove('hidden');
      iconClose.classList.add('hidden');
      document.body.style.overflow = '';
    }

    function openMenu() {
      if (isMenuOpen) return;
      isMenuOpen = true;
      mobileMenu.classList.remove('pointer-events-none', 'invisible', 'opacity-0');
      mobileMenu.setAttribute('aria-hidden', 'false');
      menuBtn.setAttribute('aria-expanded', 'true');
      iconOpen.classList.add('hidden');
      iconClose.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    }

    window.addEventListener('scroll', updateShellState, { passive: true, signal });
    updateShellState();

    menuBtn.addEventListener(
      'click',
      () => {
        if (isMenuOpen) closeMenu();
        else openMenu();
      },
      { signal }
    );

    mobileMenu.querySelectorAll('.mobile-nav-link').forEach((link) => {
      link.addEventListener('click', closeMenu, { signal });
    });

    document.addEventListener(
      'keydown',
      (e) => {
        if (e.key === 'Escape') closeMenu();
      },
      { signal }
    );
  }

  initHeader();
  document.addEventListener('astro:page-load', initHeader);
</script>
