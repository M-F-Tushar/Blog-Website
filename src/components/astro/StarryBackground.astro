---
interface Props {
  density?: 'sparse' | 'normal' | 'dense';
  class?: string;
}

const { density = 'normal', class: className } = Astro.props;

const starCounts = {
  sparse:  { small: 40,  medium: 15, large: 5  },
  normal:  { small: 80,  medium: 30, large: 10 },
  dense:   { small: 120, medium: 45, large: 15 },
};

const counts = starCounts[density];

/**
 * Deterministic seeded PRNG using a multiply-mod LCG.
 * Constants from Numerical Recipes (Knuth).
 */
function seededRandom(seed: number) {
  let state = seed >>> 0;
  return (): number => {
    state = ((state * 1664525) + 1013904223) & 0xffffffff;
    return (state >>> 0) / 4294967296;
  };
}

/**
 * Build a CSS `background-image` value containing `count` radial-gradient dots.
 * Each dot is placed at a deterministic random viewport percentage.
 */
function generateStarGradients(
  count: number,
  radiusPx: number,
  seed: number,
): string {
  const rand = seededRandom(seed);
  const gradients: string[] = [];

  for (let i = 0; i < count; i++) {
    const x = (rand() * 100).toFixed(2);
    const y = (rand() * 100).toFixed(2);

    // Mix white and blue-white for a natural sky
    const isBlueWhite = rand() > 0.55;
    const core = isBlueWhite
      ? 'rgba(210, 225, 255, 0.9)'
      : 'rgba(255, 255, 255, 0.85)';

    if (radiusPx <= 1) {
      // Small: sharp 1px pinpoint
      gradients.push(
        `radial-gradient(circle at ${x}% ${y}%, ${core} 0px, transparent ${radiusPx}px)`
      );
    } else if (radiusPx <= 2) {
      // Medium: slightly softer edge
      gradients.push(
        `radial-gradient(circle at ${x}% ${y}%, ${core} 0px, transparent ${radiusPx}px)`
      );
    } else {
      // Large: bright core with a faint glow halo
      gradients.push(
        `radial-gradient(circle at ${x}% ${y}%, white 0px, ${core} ${radiusPx * 0.4}px, transparent ${radiusPx}px)`
      );
    }
  }

  return gradients.join(', ');
}

/**
 * Split a star category into `groups` sub-layers so each sub-layer can
 * receive a different animation-delay, producing a varied twinkle effect.
 */
function splitIntoLayers(
  count: number,
  groups: number,
  radius: number,
  baseSeed: number,
): string[] {
  const layers: string[] = [];
  const perGroup = Math.ceil(count / groups);

  for (let g = 0; g < groups; g++) {
    const groupCount = Math.min(perGroup, count - g * perGroup);
    if (groupCount > 0) {
      layers.push(generateStarGradients(groupCount, radius, baseSeed + g * 7919));
    }
  }

  return layers;
}

// --- Build star sub-layers at compile time ---

const smallLayers  = splitIntoLayers(counts.small,  3, 1, 31337);
const mediumLayers = splitIntoLayers(counts.medium, 2, 2, 74521);
const largeBg      = generateStarGradients(counts.large, 3, 95173);

type LayerMeta = {
  kind: 'small' | 'medium' | 'large';
  bg: string;
  delay: string;
};

const layers: LayerMeta[] = [
  ...smallLayers.map((bg, i): LayerMeta => ({
    kind: 'small',
    bg,
    delay: `${(i * 0.7).toFixed(1)}s`,
  })),
  ...mediumLayers.map((bg, i): LayerMeta => ({
    kind: 'medium',
    bg,
    delay: `${(i * 1.4).toFixed(1)}s`,
  })),
  { kind: 'large', bg: largeBg, delay: '0s' },
];
---

<div class:list={['starry-background', className]} aria-hidden="true">
  {layers.map((layer) => (
    <div
      class={`star-layer star-layer--${layer.kind}`}
      style={`background-image: ${layer.bg}; animation-delay: ${layer.delay};`}
    />
  ))}
</div>

<style>
  .starry-background {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .star-layer {
    position: absolute;
    inset: 0;
  }

  /* --- Small stars: quick twinkle --- */
  .star-layer--small {
    animation: twinkle 3s ease-in-out infinite;
  }

  /* --- Medium stars: slower, asymmetric twinkle --- */
  .star-layer--medium {
    animation: twinkle-slow 5s ease-in-out infinite;
  }

  /* --- Large stars: gentle pulse with subtle scale --- */
  .star-layer--large {
    animation: pulse-glow 6s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 1; }
    50%      { opacity: 0.3; }
  }

  @keyframes twinkle-slow {
    0%, 100% { opacity: 0.85; }
    35%      { opacity: 0.15; }
    70%      { opacity: 0.55; }
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.9;  transform: scale(1); }
    50%      { opacity: 0.45; transform: scale(1.05); }
  }

  /* Respect reduced-motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .star-layer--small,
    .star-layer--medium,
    .star-layer--large {
      animation: none;
    }
  }
</style>
