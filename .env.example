# ============================================
# Environment Configuration Template
# ============================================
# Copy this file to .env.local and fill in your actual values
# The application will work without configuration (demo mode)
# but some features will have limited functionality
#
# To get started quickly:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in at least the Supabase credentials for full functionality
# 3. Optionally configure Formspree for contact form submissions
#
# Note: All VITE_* variables are exposed to the client-side code.
# Never include sensitive secrets here that shouldn't be public.

# ============================================
# Supabase Configuration (Optional but Recommended)
# ============================================
# Required for: Dynamic content management, user authentication, 
#               blog posts, recommendations, and site settings
# Without this: Site runs in demo mode with fallback/sample data
# 
# Setup Instructions:
# 1. Create a free account at https://supabase.com
# 2. Create a new project
# 3. Go to Settings > API in your Supabase dashboard
# 4. Copy the URL and anon/public key below
# 5. Run the database migrations from the supabase/ directory
#
# Get these values from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# Contact Form Configuration (Optional)
# ============================================
# Option 1: Use Formspree for real email submission (Recommended)
# - Sign up for free at https://formspree.io
# - Create a new form and get your endpoint URL
# - Paste the endpoint URL below (e.g., https://formspree.io/f/xyzabc123)
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Option 2: Fallback email for mailto: links
# If Formspree is not configured, the contact form will fall back to a mailto: link
# This is less reliable but works without any external service
VITE_CONTACT_EMAIL=your-email@example.com

# ============================================
# Analytics & Error Tracking (Optional)
# ============================================
# Enable error tracking (disabled by default for static hosting)
# Set to 'true' to enable error reporting to your analytics endpoint
VITE_ERROR_TRACKING_ENABLED=false

# Analytics endpoint for error reporting
# If you have a custom analytics/error tracking service, provide the endpoint here
# Leave empty to only log errors to the browser console
VITE_ANALYTICS_ENDPOINT=

# ============================================
# Development Configuration
# ============================================
# These are automatically set by Vite and don't need to be configured:
# - DEV=true (automatically set in development mode)
# - PROD=true (automatically set in production mode)
# - MODE (automatically set to 'development' or 'production')
#
# You typically don't need to set these manually.

# ============================================
# PWA Configuration
# ============================================
# PWA features are automatically enabled and don't require environment variables.
# To customize icons:
# 1. Run: npm run generate-icons
# 2. Or open scripts/icon-generator.html in your browser
# 3. Icons will be generated in the public/ directory
#
# Icon sizes generated:
# - pwa-192x192.png (< 20KB)
# - pwa-512x512.png (< 50KB)
# - apple-touch-icon.png (< 20KB)

# ============================================
# Debugging
# ============================================
# To see configuration status, append ?debug=true to any URL
# Example: http://localhost:5173/?debug=true
# This will show a status panel indicating which services are configured.
