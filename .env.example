# ============================================
# Environment Configuration Template
# ============================================
# Copy this file to .env.local and fill in your actual values
# The application will work without configuration (demo mode)
# but some features will have limited functionality

# ============================================
# Supabase Configuration (Optional)
# ============================================
# Required for: Dynamic content management, user authentication
# Without this: Site runs in demo mode with fallback data
# Get these values from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# Contact Form Configuration (Optional)
# ============================================
# Option 1: Use Formspree for real email submission (Recommended)
# Get a free endpoint from: https://formspree.io
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Option 2: Fallback email for mailto: links
# If Formspree is not configured, contact form will use mailto:
VITE_CONTACT_EMAIL=your-email@example.com

# ============================================
# Analytics & Error Tracking (Optional)
# ============================================
# Enable error tracking (disabled by default for static hosting)
VITE_ERROR_TRACKING_ENABLED=false

# Analytics endpoint for error reporting
# Leave empty to only log errors to console
VITE_ANALYTICS_ENDPOINT=

# ============================================
# Development Configuration
# ============================================
# These are automatically set by Vite
# DEV=true (in development)
# PROD=true (in production)
