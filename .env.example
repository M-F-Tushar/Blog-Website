# ============================================
# Environment Configuration Template
# ============================================
# Copy this file to .env.local and fill in your actual values.
# The application will work without configuration (demo mode)
# but some features will have limited functionality.
#
# To get started quickly:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in at least the Supabase credentials for full functionality
# 3. Optionally set PUBLIC_ADMIN_EMAIL to lock down the admin panel
#
# Note: All PUBLIC_* variables are exposed to the client-side code.
# Never include sensitive secrets here that shouldn't be public.

# ============================================
# Supabase Configuration (Optional but Recommended)
# ============================================
# Required for: Dynamic content management, user authentication,
#               blog posts, recommendations, and site settings
# Without this: Site runs in demo mode with fallback/sample data
#
# Setup Instructions:
# 1. Create a free account at https://supabase.com
# 2. Create a new project
# 3. Go to Settings > API in your Supabase dashboard
# 4. Copy the URL and anon/public key below
# 5. Run the database schema from supabase/schema.sql
#
# Get these values from: https://app.supabase.com/project/_/settings/api
PUBLIC_SUPABASE_URL=your_supabase_project_url
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================
# Admin Access Control (Recommended)
# ============================================
# Set this to the email address of your admin account.
# When set, only this email can log into the admin panel (/admin).
# Leave empty to allow any authenticated user (less secure).
PUBLIC_ADMIN_EMAIL=your-admin-email@example.com

# ============================================
# Contact Form Configuration (Optional)
# ============================================
# Option 1: Use Formspree for real email submission (Recommended)
# - Sign up for free at https://formspree.io
# - Create a new form and get your endpoint URL
PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id

# Option 2: Fallback email for mailto: links
PUBLIC_CONTACT_EMAIL=your-email@example.com

# ============================================
# Analytics & Error Tracking (Optional)
# ============================================
PUBLIC_ERROR_TRACKING_ENABLED=false
PUBLIC_ANALYTICS_ENDPOINT=

# ============================================
# Debugging
# ============================================
# Append ?debug=true to any URL to see configuration status panel.
